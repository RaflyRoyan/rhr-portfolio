---
import SectionHeading from '../SectionHeading.astro';
import { profile } from '../../data/profile';
---

<section id="education" class="border-t border-line py-20 sm:py-28">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
    <SectionHeading title="Pendidikan & sertifikasi" />
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div data-reveal>
        <h3 class="font-mono text-xs text-muted">Pendidikan</h3>
        {
          profile.education.map((edu) => (
            <div class="mt-4 rounded-xl border border-line bg-surface p-6">
              <p class="font-mono text-xs text-muted">{edu.period}</p>
              <p class="mt-2 text-lg font-semibold tracking-tight">{edu.degree}</p>
              <p class="mt-1 text-muted">{edu.institution}</p>
            </div>
          ))
        }
      </div>
      <div data-reveal>
        <h3 class="font-mono text-xs text-muted">Sertifikasi</h3>
        <ul class="mt-4 divide-y divide-line border-y border-line">
          {
            profile.certifications.map((cert) => (
              <li class="flex items-baseline justify-between gap-4 py-4">
                <span>
                  <span class="font-medium">{cert.name}</span>
                  <span class="block text-sm text-muted">{cert.issuer}</span>
                </span>
                <span class="font-mono text-sm text-muted tabular-nums">{cert.year}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
