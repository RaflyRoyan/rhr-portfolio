---
import SectionHeading from '../SectionHeading.astro';
import Doodle from '../Doodle.astro';
import { profile } from '../../data/profile';

// Sertifikasi tampil sebagai stempel; warna dan kemiringan bergantian
const stamps = [
  'text-accent rotate-[-8deg]',
  'text-pen rotate-[6deg] sm:translate-y-8',
  'text-rose-600 dark:text-rose-400 rotate-[-3deg]',
];
---

<section id="education" class="relative border-y-2 border-ink bg-pen-soft py-24 sm:py-32">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
    <SectionHeading title="Pendidikan & sertifikasi" doodle="cap" />

    <div class="grid items-center gap-16 lg:grid-cols-12 lg:gap-12">
      <!-- Kartu ijazah -->
      <div class="lg:col-span-6">
        {
          profile.education.map((edu) => {
            const [from, to] = edu.period.split(/\s*[—–-]\s*/);
            return (
              <article class="relative overflow-hidden rounded-2xl border-2 border-ink bg-surface shadow-[6px_6px_0_var(--ink)]" data-reveal>
                <div class="flex items-center justify-between gap-4 border-b-2 border-ink bg-ink px-6 py-3 text-canvas">
                  <span class="text-sm font-semibold">Pendidikan formal</span>
                  <Doodle name="cap" class="size-8 text-hl" stroke={4} delay={0.3} />
                </div>
                <div class="relative p-6 sm:p-8">
                  <p class="flex items-center gap-3">
                    <span class="hand text-3xl font-bold">{from}</span>
                    <Doodle name="arrow-right" class="h-6 w-16 text-pen" delay={0.5} />
                    <span class="hand text-3xl font-bold">{to ?? ''}</span>
                  </p>
                  <h3 class="mt-4 text-4xl leading-none font-extrabold tracking-tight sm:text-5xl">
                    <span class="highlight" data-draw style="--draw-delay: 0.4s">{edu.degree}</span>
                  </h3>
                  <p class="mt-4 pr-14 text-lg font-medium text-muted">{edu.institution}</p>
                  <Doodle name="star" class="bob absolute right-6 bottom-6 size-12 text-amber-400" stroke={4} delay={0.9} />
                </div>
                <div class="h-3 bg-[repeating-linear-gradient(90deg,var(--ink)_0_12px,transparent_12px_20px)] opacity-15" aria-hidden="true"></div>
              </article>
            );
          })
        }
      </div>

      <!-- Stempel sertifikasi -->
      <div class="lg:col-span-6">
        <p class="hand mb-6 text-2xl">sertifikasi yang sudah dikantongi</p>
        <ul class="flex flex-wrap justify-center gap-5 sm:justify-start">
          {
            profile.certifications.map((cert, i) => (
              <li
                class:list={[
                  'flex size-40 flex-col items-center justify-center rounded-full border-[3px] border-current bg-surface p-4 text-center outline-2 outline-offset-4 outline-current outline-dashed transition-[rotate,scale] duration-300 hover:scale-105 hover:rotate-0',
                  stamps[i % stamps.length],
                ]}
                data-reveal
              >
                <span class="font-hand text-3xl leading-none font-bold">{cert.year}</span>
                <span class="mt-2 text-sm leading-tight font-extrabold text-ink">{cert.name}</span>
                <span class="mt-1 text-xs font-semibold">{cert.issuer}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
