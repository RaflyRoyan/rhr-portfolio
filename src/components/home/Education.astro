---
import { Award, GraduationCap } from 'lucide-react';
import { ShineBorder } from '@/components/ui/shine-border';
import SectionHeading from '../SectionHeading.astro';
import SectionGlow from '../SectionGlow.astro';
import Reveal from '../islands/Reveal';
import GlowCard from '../islands/GlowCard';
import { getLang, getProfile, t } from '../../i18n';

const lang = getLang(Astro.url);
const tr = t(lang).education;
const profile = getProfile(lang);
const shine = ['var(--accent-from)', 'var(--accent-to)'];
---

<section id="education" class="relative isolate overflow-x-clip py-24 sm:py-32">
  <SectionGlow side="left" />
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
    <SectionHeading eyebrow={`07 · ${t(lang).sections.education}`} title={tr.title} />

    <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-6">
        <h3 class="mb-4 font-mono text-sm tracking-wide text-muted uppercase">{tr.formal}</h3>
        {
          profile.education.map((edu) => (
            <Reveal client:visible>
              <GlowCard client:visible>
                <article class="p-6 sm:p-8">
                  <span class="grid size-12 place-items-center rounded-xl border border-line bg-surface-2">
                    <GraduationCap className="size-6 text-accent" aria-hidden="true" />
                  </span>
                  <p class="mt-6 font-mono text-sm text-muted">{edu.period}</p>
                  <p class="mt-2 text-3xl leading-tight font-extrabold tracking-tight sm:text-4xl">{edu.degree}</p>
                  <p class="mt-3 text-lg font-medium text-muted">{edu.institution}</p>
                </article>
              </GlowCard>
            </Reveal>
          ))
        }
      </div>

      <div class="lg:col-span-6">
        <h3 class="mb-4 font-mono text-sm tracking-wide text-muted uppercase">{tr.certs}</h3>
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
          {
            profile.certifications.map((cert, i) => (
              <li>
                <Reveal client:visible delay={0.06 * i} className="h-full">
                  <div class="relative h-full overflow-hidden rounded-2xl border border-line bg-surface p-5">
                    <ShineBorder shineColor={shine} borderWidth={1.5} duration={12} />
                    <div class="flex items-start gap-4">
                      <Award className="mt-0.5 size-6 shrink-0 text-accent" aria-hidden="true" />
                      <div>
                        <p class="font-bold leading-snug">{cert.name}</p>
                        <p class="mt-1 text-sm text-muted">{cert.issuer}</p>
                        <p class="mt-3 font-mono text-xs text-muted">{cert.year}</p>
                      </div>
                    </div>
                  </div>
                </Reveal>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
