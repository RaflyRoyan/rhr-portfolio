---
import type { CollectionEntry } from 'astro:content';
import { ArrowRight, CircleCheck } from 'lucide-react';
import { BentoGrid } from '@/components/ui/bento-grid';
import { BorderBeam } from '@/components/ui/border-beam';
import { RetroGrid } from '@/components/ui/retro-grid';
import SectionHeading from '../SectionHeading.astro';
import SectionGlow from '../SectionGlow.astro';
import ProjectCard from '../ProjectCard.astro';
import ProjectCover from '../ProjectCover.astro';
import Reveal from '../islands/Reveal';
import GlowCard from '../islands/GlowCard';
import { getLang, localePath, t } from '../../i18n';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
const lang = getLang(Astro.url);
const tr = t(lang).projects;

// Bento: tiap project featured jadi kartu lebar (2 kolom), sisanya kartu biasa.
// Project featured pertama mendapat border beam.
const tiles = projects.map((project) => ({ project, big: project.data.featured }));
const firstBig = tiles.find((tile) => tile.big)?.project.id;
---

<section id="projects" class="relative isolate overflow-x-clip py-24 sm:py-32">
  <SectionGlow side="right" />
  <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[28rem] overflow-hidden [mask-image:linear-gradient(to_bottom,white,transparent)]" aria-hidden="true">
    <RetroGrid client:visible angle={65} cellSize={56} opacity={0.7} lightLineColor="#8b84f0" darkLineColor="#6d63d9" />
  </div>
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-x-8">
      <SectionHeading eyebrow={`02 · ${t(lang).sections.projects}`} title={tr.title} note={tr.note} />
      <a
        href={localePath(lang, '/projects')}
        class="mb-12 inline-flex items-center gap-2 rounded-full border border-line bg-surface/70 px-5 py-2.5 text-sm font-semibold backdrop-blur transition-colors hover:border-muted"
      >
        {tr.all} ({projects.length})
        <ArrowRight className="size-4" aria-hidden="true" />
      </a>
    </div>

    <BentoGrid className="auto-rows-auto grid-flow-dense grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
      {
        tiles.map(({ project, big }) =>
          big ? (
            <div class="relative sm:col-span-2">
              <GlowCard client:visible className="h-full">
                <a href={localePath(lang, `/projects/${project.id}`)} class="group grid h-full gap-6 p-4 sm:grid-cols-[1.05fr_1fr] sm:gap-8 sm:p-6">
                  <div class="flex flex-col">
                    <ProjectCover project={project} />
                    <p class="mt-5 flex items-center gap-2 font-mono text-xs text-muted">
                      <span class="rounded-full bg-linear-to-r from-accent-from to-accent-to px-2 py-0.5 font-sans text-[11px] font-semibold text-white">{tr.main}</span>
                      {project.data.category} / {project.data.period}
                    </p>
                    <h3 class="mt-2 text-2xl font-extrabold tracking-tight transition-colors group-hover:text-accent sm:text-3xl" transition:name={`project-title-${project.id}`}>
                      <span>{project.data.title}</span>
                    </h3>
                    <p class="mt-3 leading-7 text-muted">{project.data.summary}</p>
                  </div>
                  <div class="flex flex-col sm:border-l sm:border-line sm:pl-8">
                    {project.data.highlights.length > 0 && (
                      <ul class="grid gap-2.5 text-sm leading-6">
                        {project.data.highlights.slice(0, 6).map((item) => (
                          <li class="flex gap-2.5">
                            <CircleCheck className="mt-1 size-4 shrink-0 text-accent" aria-hidden="true" />
                            {item}
                          </li>
                        ))}
                      </ul>
                    )}
                    <ul class="mt-auto flex flex-wrap gap-1.5 pt-6" aria-label={tr.tech} transition:name={`project-tech-${project.id}`}>
                      {project.data.tech.slice(0, 8).map((item) => (
                        <li class="rounded-md border border-line bg-surface-2 px-1.5 py-0.5 font-mono text-[11px] text-muted">{item}</li>
                      ))}
                      {project.data.tech.length > 8 && <li class="px-1 py-0.5 font-mono text-[11px] text-muted">+{project.data.tech.length - 8}</li>}
                    </ul>
                  </div>
                </a>
              </GlowCard>
              {project.id === firstBig && (
                <div class="pointer-events-none absolute inset-0 z-50 rounded-2xl motion-reduce:hidden" aria-hidden="true">
                  <BorderBeam client:visible size={120} duration={8} colorFrom="var(--accent-from)" colorTo="var(--accent-to)" borderWidth={1.5} />
                </div>
              )}
            </div>
          ) : (
            <div class="h-full">
              <ProjectCard project={project} />
            </div>
          ),
        )
      }
      <Reveal client:visible className="h-full min-h-48">
        <a
          href={localePath(lang, '/projects')}
          class="group flex h-full min-h-48 flex-col items-center justify-center gap-3 rounded-2xl border border-dashed border-line p-6 text-center transition-colors hover:border-muted hover:bg-surface"
        >
          <span class="grid size-11 place-items-center rounded-full border border-line bg-surface transition-transform group-hover:translate-x-1">
            <ArrowRight className="size-5 text-accent" aria-hidden="true" />
          </span>
          <span class="text-lg font-semibold">{tr.seeAll}</span>
          <span class="font-mono text-xs text-muted">{tr.filterable}</span>
        </a>
      </Reveal>
    </BentoGrid>
  </div>
</section>
