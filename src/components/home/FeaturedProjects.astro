---
import type { CollectionEntry } from 'astro:content';
import SectionHeading from '../SectionHeading.astro';
import ProjectCard from '../ProjectCard.astro';
import ProjectCover from '../ProjectCover.astro';
import Doodle from '../Doodle.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
// Project pertama (order terkecil) tampil besar, sisanya di grid
const [lead, ...rest] = projects;
---

<section id="projects" class="relative border-y-2 border-ink bg-pen-soft py-24 sm:py-32">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-x-8">
      <SectionHeading title="Project pilihan" doodle="star" note="Sistem internal Bapenda Kota Surabaya. Detail sensitif sengaja disamarkan." />
      <a
        href="/projects"
        class="mb-12 rounded-lg border-2 border-ink bg-surface px-4 py-2 text-sm font-semibold shadow-[3px_3px_0_var(--ink)] transition-[translate,box-shadow] hover:-translate-y-0.5 hover:shadow-[5px_5px_0_var(--ink)]"
      >
        Semua project ({projects.length})
      </a>
    </div>

    {
      lead && (
        <a
          href={`/projects/${lead.id}`}
          class="group relative grid gap-8 rounded-2xl border-2 border-ink bg-surface p-4 shadow-[6px_6px_0_var(--ink)] transition-[translate,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-[9px_9px_0_var(--ink)] sm:p-6 lg:grid-cols-2 lg:gap-10"
          data-reveal
        >
          <span class="hand absolute -top-5 right-6 -rotate-3 rounded bg-hl px-3 py-0.5 text-lg text-ink">project utama</span>
          <ProjectCover project={lead} size="page" class="lg:h-full lg:min-h-72" />
          <div class="flex flex-col">
            <p class="font-mono text-xs text-muted">{lead.data.category} / {lead.data.period}</p>
            <h3 class="mt-2 text-3xl font-extrabold tracking-tight group-hover:text-accent sm:text-4xl" transition:name={`project-title-${lead.id}`}>
              <span>{lead.data.title}</span>
            </h3>
            <p class="mt-3 leading-7 text-muted">{lead.data.summary}</p>
            {
              lead.data.highlights.length > 0 && (
                <ul class="mt-5 grid gap-2 text-sm sm:grid-cols-2">
                  {lead.data.highlights.slice(0, 6).map((item, i) => (
                    <li class="flex gap-2">
                      <Doodle name="check" class="mt-0.5 size-4 shrink-0 text-accent" stroke={10} delay={0.4 + i * 0.12} />
                      {item}
                    </li>
                  ))}
                </ul>
              )
            }
            <ul class="mt-auto flex flex-wrap gap-1.5 pt-6" aria-label="Teknologi" transition:name={`project-tech-${lead.id}`}>
              {lead.data.tech.map((item) => (
                <li class="rounded border border-line px-1.5 py-0.5 font-mono text-[11px] text-muted">{item}</li>
              ))}
            </ul>
          </div>
        </a>
      )
    }

    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        rest.map((project) => (
          <div class="flex" data-reveal>
            <ProjectCard project={project} class="w-full" />
          </div>
        ))
      }
    </div>
  </div>
</section>
