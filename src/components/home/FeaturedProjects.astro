---
import type { CollectionEntry } from 'astro:content';
import SectionHeading from '../SectionHeading.astro';
import ProjectCard from '../ProjectCard.astro';
import ProjectCover from '../ProjectCover.astro';
import Doodle from '../Doodle.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;

// Bento: project featured jadi kartu besar (2×2 di desktop), sisanya kecil.
// Urutan disusun selang-seling supaya kartu besar bergantian kiri/kanan:
// blok genap = besar, kecil, kecil; blok ganjil = kecil, besar, kecil (grid-flow-dense mengisi celah).
const big = projects.filter((p) => p.data.featured);
const small = projects.filter((p) => !p.data.featured);
type Tile = { project: CollectionEntry<'projects'>; big: boolean };
const tiles: Tile[] = [];
big.forEach((project, i) => {
  const next = () => small.shift();
  const pair = [next(), next()].filter((p) => p !== undefined).map((p) => ({ project: p, big: false }));
  const bigTile = { project, big: true };
  tiles.push(...(i % 2 === 0 ? [bigTile, ...pair] : [pair[0], bigTile, pair[1]].filter((t) => t !== undefined)));
});
tiles.push(...small.map((project) => ({ project, big: false })));
---

<section id="projects" class="relative border-y-2 border-ink bg-pen-soft py-24 sm:py-32">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-x-8">
      <SectionHeading title="Project pilihan" doodle="star" note="Sistem internal Bapenda Kota Surabaya. Detail sensitif sengaja disamarkan." />
      <a
        href="/projects"
        class="mb-12 rounded-lg border-2 border-ink bg-surface px-4 py-2 text-sm font-semibold shadow-[3px_3px_0_var(--ink)] transition-[translate,box-shadow] hover:-translate-y-0.5 hover:shadow-[5px_5px_0_var(--ink)]"
      >
        Semua project ({projects.length})
      </a>
    </div>

    <div class="grid grid-flow-dense gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        tiles.map(({ project, big }) =>
          big ? (
            <a
              href={`/projects/${project.id}`}
              class="group relative flex flex-col gap-5 rounded-2xl border-2 border-ink bg-surface p-4 shadow-[6px_6px_0_var(--ink)] transition-[translate,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-[9px_9px_0_var(--ink)] sm:col-span-2 sm:p-6 lg:row-span-2"
              data-reveal
            >
              <span class="hand absolute -top-5 right-6 -rotate-3 rounded bg-hl px-3 py-0.5 text-lg text-ink">project utama</span>
              <ProjectCover project={project} size="page" />
              <div class="flex flex-1 flex-col">
                <p class="font-mono text-xs text-muted">{project.data.category} / {project.data.period}</p>
                <h3 class="mt-2 text-2xl font-extrabold tracking-tight group-hover:text-accent sm:text-3xl" transition:name={`project-title-${project.id}`}>
                  <span>{project.data.title}</span>
                </h3>
                <p class="mt-3 leading-7 text-muted">{project.data.summary}</p>
                {project.data.highlights.length > 0 && (
                  <ul class="mt-5 grid gap-2 text-sm sm:grid-cols-2">
                    {project.data.highlights.slice(0, 6).map((item, i) => (
                      <li class="flex gap-2">
                        <Doodle name="check" class="mt-0.5 size-4 shrink-0 text-accent" stroke={10} delay={0.4 + i * 0.12} />
                        {item}
                      </li>
                    ))}
                  </ul>
                )}
                <ul class="mt-auto flex flex-wrap gap-1.5 pt-6" aria-label="Teknologi" transition:name={`project-tech-${project.id}`}>
                  {project.data.tech.slice(0, 8).map((item) => (
                    <li class="rounded border border-line px-1.5 py-0.5 font-mono text-[11px] text-muted">{item}</li>
                  ))}
                  {project.data.tech.length > 8 && <li class="px-1 py-0.5 font-mono text-[11px] text-muted">+{project.data.tech.length - 8}</li>}
                </ul>
              </div>
            </a>
          ) : (
            <div class="flex" data-reveal>
              <ProjectCard project={project} class="w-full" />
            </div>
          ),
        )
      }
      <a
        href="/projects"
        class="group flex min-h-48 flex-col items-center justify-center gap-3 rounded-2xl border-2 border-dashed border-ink/40 p-6 text-center transition-colors hover:border-ink hover:bg-surface"
        data-reveal
      >
        <Doodle name="arrow-curve" class="h-12 w-16 text-pen" delay={0.3} />
        <span class="hand text-2xl">lihat semua project</span>
        <span class="font-mono text-xs text-muted">bisa difilter per kategori</span>
      </a>
    </div>
  </div>
</section>
