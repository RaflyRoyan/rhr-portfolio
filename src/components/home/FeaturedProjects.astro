---
import type { CollectionEntry } from 'astro:content';
import SectionHeading from '../SectionHeading.astro';
import ProjectCard from '../ProjectCard.astro';
import ProjectCover from '../ProjectCover.astro';
import Doodle from '../Doodle.astro';
import { getLang, localePath, t } from '../../i18n';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
const lang = getLang(Astro.url);
const tr = t(lang).projects;

// Panel malam berisi grid project yang mengalir ke bawah.
// Project featured jadi kartu selebar baris, tiap kartu lebar diikuti satu baris berisi tiga kartu kecil.
const big = projects.filter((p) => p.data.featured);
const small = projects.filter((p) => !p.data.featured);
type Tile = { project: CollectionEntry<'projects'>; big: boolean };
const tiles: Tile[] = [];
big.forEach((project) => {
  tiles.push({ project, big: true });
  tiles.push(...small.splice(0, 3).map((p) => ({ project: p, big: false })));
});
tiles.push(...small.map((project) => ({ project, big: false })));
---

<section id="projects" class="inverse relative" data-ink-skip>
  <div class="py-24 sm:py-32">
    <div class="mx-auto flex w-full max-w-6xl flex-wrap items-end justify-between gap-x-8 px-4 sm:px-6">
      <SectionHeading title={tr.title} doodle="star" note={tr.note} />
      <a
        href={localePath(lang, '/projects')}
        class="mb-12 rounded-full border border-ink/25 px-5 py-2.5 text-sm font-semibold transition-colors hover:border-ink hover:bg-ink hover:text-canvas"
      >
        {tr.all} ({projects.length})
      </a>
    </div>

    <div>
      <ol
        class="mx-auto grid max-w-6xl grid-flow-dense gap-5 px-4 sm:grid-cols-2 sm:px-6 lg:grid-cols-3"
      >
        {
          tiles.map(({ project, big }) =>
            big ? (
              <li class="flex sm:col-span-2 lg:col-span-3" data-reveal>
                <a
                  href={localePath(lang, `/projects/${project.id}`)}
                  class="sheet lift group relative grid w-full gap-6 rounded-3xl p-4 sm:grid-cols-[1.05fr_1fr] sm:gap-8 sm:p-6"
                >
                  <span class="hand absolute -top-4 right-6 -rotate-3 rounded bg-hl px-3 py-0.5 text-lg text-ink">{tr.main}</span>
                  <div class="flex flex-col">
                    <ProjectCover project={project} />
                    <p class="mt-5 font-mono text-xs text-muted">{project.data.category} / {project.data.period}</p>
                    <h3 class="mt-2 text-2xl font-extrabold tracking-tight group-hover:text-accent sm:text-3xl" transition:name={`project-title-${project.id}`}>
                      <span>{project.data.title}</span>
                    </h3>
                    <p class="mt-3 leading-7 text-muted">{project.data.summary}</p>
                  </div>
                  <div class="flex flex-col sm:border-l sm:border-line sm:pl-8">
                    {project.data.highlights.length > 0 && (
                      <ul class="grid gap-2.5 text-sm leading-6">
                        {project.data.highlights.slice(0, 6).map((item, i) => (
                          <li class="flex gap-2.5">
                            <Doodle name="check" class="mt-1 size-4 shrink-0 text-accent" stroke={10} delay={0.3 + i * 0.1} />
                            {item}
                          </li>
                        ))}
                      </ul>
                    )}
                    <ul class="mt-auto flex flex-wrap gap-1.5 pt-6" aria-label={tr.tech} transition:name={`project-tech-${project.id}`}>
                      {project.data.tech.slice(0, 8).map((item) => (
                        <li class="rounded border border-line px-1.5 py-0.5 font-mono text-[11px] text-muted">{item}</li>
                      ))}
                      {project.data.tech.length > 8 && <li class="px-1 py-0.5 font-mono text-[11px] text-muted">+{project.data.tech.length - 8}</li>}
                    </ul>
                  </div>
                </a>
              </li>
            ) : (
              <li class="flex" data-reveal>
                <ProjectCard project={project} class="w-full" />
              </li>
            ),
          )
        }
        <li class="flex min-h-48" data-reveal>
          <a
            href={localePath(lang, '/projects')}
            class="group flex w-full flex-col items-center justify-center gap-3 rounded-3xl border border-dashed border-ink/30 p-6 text-center transition-colors hover:border-ink hover:bg-surface"
          >
            <Doodle name="arrow-curve" class="h-12 w-16 text-pen" delay={0.3} />
            <span class="hand text-2xl">{tr.seeAll}</span>
            <span class="font-mono text-xs text-muted">{tr.filterable}</span>
          </a>
        </li>
      </ol>
    </div>
  </div>
</section>
