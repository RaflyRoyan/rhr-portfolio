---
import SectionHeading from '../SectionHeading.astro';
import Doodle from '../Doodle.astro';
import { profile } from '../../data/profile';

// Warna dan kemiringan sticky note, urut sesuai profile.principles
const notes = [
  'bg-note rotate-[-2deg]',
  'bg-surface rotate-[1.5deg] lg:translate-y-5',
  'bg-accent-soft rotate-[-1deg]',
  'bg-note rotate-[2deg] lg:translate-y-5',
];
---

<section id="about" class="relative border-y-2 border-ink bg-pen-soft py-24 sm:py-32">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-7">
        <SectionHeading title="Tentang saya" doodle="magnifier" />
        <p class="text-2xl leading-snug font-semibold tracking-tight text-balance sm:text-[1.75rem]" data-reveal>
          {profile.bio.summary}
        </p>
      </div>
      <div class="space-y-5 leading-7 text-muted lg:col-span-5 lg:self-end" data-reveal>
        <p>{profile.bio.approach}</p>
        <p>{profile.bio.production}</p>
      </div>
    </div>

    <p class="hand mt-16 flex items-end gap-2 text-2xl" data-reveal>
      prinsip kerja saya
      <Doodle name="arrow-down" class="h-10 w-7" delay={0.3} />
    </p>
    <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        profile.principles.map(({ title, description }, i) => (
          <li
            class:list={['sticky-note rounded-sm p-6 pt-8 transition-[rotate] duration-500 hover:rotate-0', notes[i % notes.length]]}
            data-reveal
          >
            <Doodle name="check" class="size-7 text-accent" stroke={9} delay={0.3 + i * 0.2} />
            <p class="mt-3 text-lg leading-snug font-bold">{title}</p>
            <p class="mt-2 text-sm leading-6 text-ink/70">{description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
