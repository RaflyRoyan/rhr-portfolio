---
import SectionHeading from '../SectionHeading.astro';
import Doodle from '../Doodle.astro';
import { profile } from '../../data/profile';

// Ringkasan dipecah per kata supaya bisa "terisi tinta" mengikuti scroll (teks tetap sama)
const words = profile.bio.summary.split(' ');
---

<section id="about" class="relative border-y border-line bg-pen-soft py-24 sm:py-32">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-8">
        <SectionHeading title="Tentang saya" doodle="magnifier" />
        <p class="text-[1.75rem] leading-[1.25] font-semibold tracking-tight text-balance sm:text-4xl" data-ink-words>
          {words.map((word) => <span class="ink-word">{word} </span>)}
        </p>
      </div>
      <div class="space-y-5 border-line leading-7 text-muted lg:col-span-4 lg:self-end lg:border-l lg:pl-8" data-reveal>
        <p>{profile.bio.approach}</p>
        <p>{profile.bio.production}</p>
      </div>
    </div>

    <p class="hand mt-20 flex items-end gap-2 text-2xl" data-reveal>
      prinsip kerja saya
      <Doodle name="arrow-down" class="h-10 w-7" delay={0.3} />
    </p>
    <ul class="mt-6 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        profile.principles.map(({ title, description }, i) => (
          <li class="border-t-2 border-ink pt-5" data-reveal>
            <Doodle name="check" class="size-7 text-accent" stroke={9} delay={0.3 + i * 0.15} />
            <p class="mt-3 text-lg leading-snug font-bold">{title}</p>
            <p class="mt-2 text-sm leading-6 text-muted">{description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import { onPageLoad, prefersReducedMotion } from '../../scripts/lifecycle';

  // Kata menyala satu per satu: mulai saat paragraf masuk 85% layar, penuh saat ujungnya di 45%
  onPageLoad(() => {
    const para = document.querySelector<HTMLElement>('[data-ink-words]');
    if (!para) return;
    const words = [...para.querySelectorAll<HTMLElement>('.ink-word')];
    if (prefersReducedMotion()) {
      words.forEach((w) => w.setAttribute('data-lit', ''));
      return;
    }
    let frame = 0;
    const paint = () => {
      frame = 0;
      const rect = para.getBoundingClientRect();
      const vh = window.innerHeight;
      const start = vh * 0.85;
      const end = vh * 0.45;
      const p = Math.min(Math.max((start - rect.top) / (start - end + rect.height), 0), 1);
      const lit = Math.round(p * words.length);
      words.forEach((w, i) => w.toggleAttribute('data-lit', i < lit));
    };
    const onScroll = () => {
      if (!frame) frame = requestAnimationFrame(paint);
    };
    paint();
    window.addEventListener('scroll', onScroll, { passive: true });
    return () => {
      cancelAnimationFrame(frame);
      window.removeEventListener('scroll', onScroll);
    };
  });
</script>
