---
import { CircleCheck } from 'lucide-react';
import SectionHeading from '../SectionHeading.astro';
import Reveal from '../islands/Reveal';
import GlowCard from '../islands/GlowCard';
import { getLang, getProfile, t } from '../../i18n';

const lang = getLang(Astro.url);
const tr = t(lang).about;
const profile = getProfile(lang);
---

<section id="about" class="relative py-24 sm:py-32">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-7">
        <SectionHeading title={tr.title} />
        <Reveal client:visible delay={0.1}>
          <p class="text-2xl leading-snug font-semibold tracking-tight text-balance sm:text-3xl">{profile.bio.summary}</p>
        </Reveal>
      </div>
      <Reveal client:visible delay={0.2} className="space-y-5 leading-7 text-muted lg:col-span-5 lg:self-end">
        <p>{profile.bio.approach}</p>
        <p>{profile.bio.production}</p>
      </Reveal>
    </div>

    <h3 class="mt-20 font-mono text-sm tracking-wide text-muted uppercase">{tr.principles}</h3>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        profile.principles.map(({ title, description }, i) => (
          <li>
            <Reveal client:visible delay={0.06 * i} className="h-full">
              <GlowCard client:visible className="h-full">
                <div class="p-6">
                  <CircleCheck className="size-6 text-accent" aria-hidden="true" />
                  <p class="mt-4 text-lg leading-snug font-bold">{title}</p>
                  <p class="mt-2 text-sm leading-6 text-muted">{description}</p>
                </div>
              </GlowCard>
            </Reveal>
          </li>
        ))
      }
    </ul>
  </div>
</section>
