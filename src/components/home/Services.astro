---
import { Boxes, ChartColumn, Database, Plug, RefreshCw, Server } from 'lucide-react';
import SectionHeading from '../SectionHeading.astro';
import SectionGlow from '../SectionGlow.astro';
import Reveal from '../islands/Reveal';
import GlowCard from '../islands/GlowCard';
import { getLang, getProfile, t } from '../../i18n';

// Ikon urut sesuai profile.services
const icons = [Server, Database, RefreshCw, ChartColumn, Plug, Boxes];
const lang = getLang(Astro.url);
const tr = t(lang).services;
const profile = getProfile(lang);
---

<section id="services" class="relative isolate overflow-x-clip py-24 sm:py-32">
  <SectionGlow side="right" />
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
    <SectionHeading eyebrow={`04 · ${t(lang).sections.services}`} title={tr.title} note={tr.note} />

    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        profile.services.map(({ title, description }, i) => {
          const Icon = icons[i % icons.length];
          return (
            <li>
              <Reveal client:visible delay={0.05 * i} className="h-full">
                <GlowCard client:visible className="h-full">
                  <div class="p-7">
                    <span class="grid size-11 place-items-center rounded-xl border border-line bg-surface-2">
                      <Icon className="size-5 text-accent" aria-hidden="true" />
                    </span>
                    <h3 class="mt-5 text-xl font-bold tracking-tight">{title}</h3>
                    <p class="mt-2 leading-7 text-muted">{description}</p>
                  </div>
                </GlowCard>
              </Reveal>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
