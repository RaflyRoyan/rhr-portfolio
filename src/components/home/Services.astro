---
import SectionHeading from '../SectionHeading.astro';
import Doodle, { type DoodleName } from '../Doodle.astro';
import { profile } from '../../data/profile';

// Pola bento: 3 kolom di desktop, 2 di tablet. Ikon, warna, dan lebar urut sesuai profile.services
const tiles: { icon: DoodleName; tone: string; span: string }[] = [
  { icon: 'server', tone: 'bg-ink text-canvas', span: 'sm:col-span-2 lg:col-span-2' },
  { icon: 'db', tone: 'bg-note', span: '' },
  { icon: 'sync', tone: 'bg-pen-soft', span: '' },
  { icon: 'chart', tone: 'bg-surface', span: 'lg:col-span-2' },
  { icon: 'plug', tone: 'bg-accent-soft', span: '' },
  { icon: 'boxes', tone: 'bg-surface', span: 'sm:col-span-2 lg:col-span-2' },
];
---

<section id="services" class="relative py-24 sm:py-32">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
    <SectionHeading title="Yang saya kerjakan" note="Dari query Oracle sampai dashboard yang dibaca pimpinan." />
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        profile.services.map(({ title, description }, i) => {
          const tile = tiles[i % tiles.length];
          const dark = tile.tone.includes('bg-ink');
          return (
            <li
              class:list={[
                'group relative flex min-h-56 flex-col justify-between overflow-hidden rounded-2xl border-2 border-ink p-6 transition-[translate,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-[5px_5px_0_var(--ink)] sm:p-7',
                tile.tone,
                tile.span,
              ]}
              data-reveal
            >
              <Doodle
                name={tile.icon}
                class:list={['size-14 transition-[rotate] duration-500 group-hover:-rotate-6 sm:size-16', dark ? 'text-hl' : 'text-pen']}
                stroke={4}
                delay={0.2}
              />
              <div class="mt-10">
                <h3 class="text-xl font-bold tracking-tight sm:text-2xl">{title}</h3>
                <p class:list={['mt-2 max-w-md text-sm leading-6', dark ? 'text-canvas/75' : 'text-muted']}>{description}</p>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
