---
import SectionHeading from '../SectionHeading.astro';
import Doodle, { type DoodleName } from '../Doodle.astro';
import { getLang, getProfile, t } from '../../i18n';

// Ikon urut sesuai profile.services
const icons: DoodleName[] = ['server', 'db', 'sync', 'chart', 'plug', 'boxes'];
const lang = getLang(Astro.url);
const tr = t(lang).services;
const profile = getProfile(lang);
---

<section id="services" class="relative border-y border-line bg-pen-soft py-24 sm:py-32">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
    <SectionHeading title={tr.title} note={tr.note} />

    <!-- Daftar indeks: judul besar di kiri, penjelasan di kanan; baris bergeser halus saat hover -->
    <ul class="border-t-2 border-ink">
      {
        profile.services.map(({ title, description }, i) => (
          <li
            class="group grid gap-x-8 gap-y-3 border-b border-line py-8 transition-colors duration-300 hover:bg-surface/60 sm:grid-cols-[3.5rem_1fr] lg:grid-cols-[3.5rem_minmax(0,1fr)_minmax(0,1.15fr)] lg:items-baseline"
            data-reveal
          >
            <Doodle
              name={icons[i % icons.length]}
              class="size-11 text-pen transition-[rotate,scale] duration-500 group-hover:scale-110 group-hover:-rotate-6 lg:translate-y-2"
              stroke={4}
              delay={0.2}
            />
            <h3 class="text-2xl font-bold tracking-tight transition-[translate] duration-300 group-hover:translate-x-1.5 sm:text-3xl">{title}</h3>
            <p class="max-w-xl leading-7 text-muted sm:col-start-2 lg:col-start-3">{description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
