---
import SectionHeading from '../SectionHeading.astro';
import Doodle from '../Doodle.astro';
import { getLang, getProfile, t } from '../../i18n';

const lang = getLang(Astro.url);
const tr = t(lang).experience;
const profile = getProfile(lang);
---

<section id="experience" class="relative py-24 sm:py-32">
  <div class="relative mx-auto grid w-full max-w-6xl gap-12 px-4 sm:px-6 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-4">
      <div class="lg:sticky lg:top-28">
        <SectionHeading title={tr.title} doodle="sync" />
        <Doodle name="server" class="bob hidden size-36 -rotate-6 text-pen/50 lg:block" stroke={2.5} />
      </div>
    </div>

    <div class="relative lg:col-span-8" data-timeline>
      <!-- Track + progress yang terisi saat scroll -->
      <span class="absolute top-2 bottom-2 left-[7px] w-0.5 bg-ink/15" aria-hidden="true"></span>
      <span
        class="absolute top-2 bottom-2 left-[7px] w-0.5 origin-top bg-accent"
        style="transform: scaleY(var(--progress, 1))"
        aria-hidden="true"
      ></span>

      <ol class="flex flex-col gap-10 pl-9">
        {
          profile.experience.map((job) => (
            <li class="relative" data-timeline-item data-reveal>
              <span
                class="absolute top-7 -left-9 size-[16px] rounded-full border-2 border-ink/30 bg-canvas transition-colors duration-300 data-[reached]:border-accent data-[reached]:bg-accent"
                data-timeline-dot
                data-reached
                aria-hidden="true"
              />
              <div class="sheet rounded-3xl p-6 sm:p-8">
                <p class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-muted sm:text-sm">
                  {job.period}
                  {job.active && (
                    <span class="relative ml-2 px-2 font-hand text-base font-bold text-accent">
                      {tr.active}
                      <Doodle name="circle" class="absolute -inset-x-1.5 -inset-y-1.5 h-[calc(100%+0.75rem)] w-[calc(100%+0.75rem)]" stroke={4} delay={0.4} />
                    </span>
                  )}
                </p>
                <h3 class="mt-2 text-2xl font-extrabold tracking-tight sm:text-3xl">{job.role}</h3>
                <p class="mt-1 font-medium text-muted">{job.company}</p>
                <p class="mt-4 leading-7 text-muted">{job.description}</p>
                <ul class="mt-5 grid gap-x-6 gap-y-2.5 text-sm leading-6 sm:grid-cols-2">
                  {job.points.map((point) => (
                    <li class="flex gap-3">
                      <span class="font-mono font-bold text-accent" aria-hidden="true">
                        +
                      </span>
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  import { onPageLoad, prefersReducedMotion } from '../../scripts/lifecycle';

  // Progress line terisi mengikuti posisi scroll; titik menyala setelah dilewati
  onPageLoad(() => {
    const timeline = document.querySelector<HTMLElement>('[data-timeline]');
    if (!timeline || prefersReducedMotion()) return;
    const dots = [...timeline.querySelectorAll<HTMLElement>('[data-timeline-dot]')];
    let ticking = false;

    const update = () => {
      ticking = false;
      const rect = timeline.getBoundingClientRect();
      const anchor = window.innerHeight * 0.6;
      const progress = Math.min(Math.max((anchor - rect.top) / rect.height, 0), 1);
      timeline.style.setProperty('--progress', progress.toFixed(4));
      dots.forEach((dot) => {
        const reached = dot.getBoundingClientRect().top < anchor;
        dot.toggleAttribute('data-reached', reached);
      });
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    return () => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
    };
  });
</script>
