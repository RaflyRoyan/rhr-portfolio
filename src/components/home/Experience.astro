---
import SectionHeading from '../SectionHeading.astro';
import Reveal from '../islands/Reveal';
import GlowCard from '../islands/GlowCard';
import { getLang, getProfile, t } from '../../i18n';

const lang = getLang(Astro.url);
const tr = t(lang).experience;
const profile = getProfile(lang);
---

<section id="experience" class="relative py-24 sm:py-32">
  <div class="relative mx-auto grid w-full max-w-6xl gap-12 px-4 sm:px-6 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-4">
      <div class="lg:sticky lg:top-28">
        <SectionHeading title={tr.title} />
      </div>
    </div>

    <div class="relative lg:col-span-8">
      <!-- Garis timeline bergradien -->
      <span class="absolute top-2 bottom-2 left-[7px] w-0.5 rounded-full bg-linear-to-b from-accent-from via-accent-to to-transparent" aria-hidden="true"></span>

      <ol class="flex flex-col gap-8 pl-9">
        {
          profile.experience.map((job, i) => (
            <li class="relative">
              <span
                class:list={[
                  'absolute top-8 -left-9 size-4 rounded-full border-2 border-canvas ring-1 ring-line',
                  job.active ? 'bg-accent shadow-[0_0_0_4px_color-mix(in_oklab,var(--accent)_25%,transparent)]' : 'bg-surface-2',
                ]}
                aria-hidden="true"
              />
              <Reveal client:visible delay={0.08 * i}>
                <GlowCard client:visible>
                  <div class="p-6 sm:p-8">
                    <p class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-muted sm:text-sm">
                      {job.period}
                      {job.active && (
                        <span class="inline-flex items-center gap-1.5 rounded-full border border-accent/30 bg-accent-soft px-2.5 py-0.5 font-sans text-xs font-semibold text-accent">
                          <span class="size-1.5 rounded-full bg-accent" aria-hidden="true" />
                          {tr.active}
                        </span>
                      )}
                    </p>
                    <h3 class="mt-2 text-2xl font-extrabold tracking-tight sm:text-3xl">{job.role}</h3>
                    <p class="mt-1 font-medium text-muted">{job.company}</p>
                    <p class="mt-4 leading-7 text-muted">{job.description}</p>
                    <ul class="mt-5 grid gap-x-6 gap-y-2.5 text-sm leading-6 sm:grid-cols-2">
                      {job.points.map((point) => (
                        <li class="flex gap-3">
                          <span class="mt-2 size-1.5 shrink-0 rounded-full bg-linear-to-r from-accent-from to-accent-to" aria-hidden="true" />
                          <span>{point}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </GlowCard>
              </Reveal>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
