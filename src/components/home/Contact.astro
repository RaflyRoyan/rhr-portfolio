---
import { Meteors } from '@/components/ui/meteors';
import ShimmerLink from '../ShimmerLink.astro';
import SectionGlow from '../SectionGlow.astro';
import Reveal from '../islands/Reveal';
import ContactDock from '../islands/ContactDock';
import ContactGlobe from '../islands/ContactGlobe';
import { getLang, getProfile, localePath, t } from '../../i18n';

const lang = getLang(Astro.url);
const tr = t(lang).contact;
const { email, whatsapp, phone, location, cta } = getProfile(lang).contact;
const dockItems = [
  { icon: 'mail' as const, label: tr.email, href: `mailto:${email}` },
  { icon: 'whatsapp' as const, label: `${tr.whatsapp} (${phone})`, href: whatsapp, external: true },
  { icon: 'copy' as const, label: tr.copy, copyEmail: email },
  { icon: 'projects' as const, label: tr.projects, href: localePath(lang, '/projects') },
];
---

<section id="contact" class="relative isolate overflow-x-clip px-4 py-24 sm:px-6 sm:py-32">
  <SectionGlow side="right" />
  <Reveal client:visible className="relative mx-auto w-full max-w-6xl">
    <div class="relative overflow-hidden rounded-[2rem] border border-line bg-surface/80 px-6 py-14 shadow-(--shadow-lift) backdrop-blur sm:px-12 sm:py-16">
      <span
        class="pointer-events-none absolute -top-40 -left-40 size-96 rounded-full bg-[radial-gradient(circle,color-mix(in_oklab,var(--accent-from)_22%,transparent),transparent_70%)]"
        aria-hidden="true"></span>
      <div class="pointer-events-none absolute inset-0 overflow-hidden motion-reduce:hidden" aria-hidden="true">
        <Meteors client:idle number={18} className="bg-accent [&>div]:from-accent" />
      </div>

      <div class="relative grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,24rem)]">
        <div class="max-w-2xl">
          <p class="font-mono text-sm text-accent">{tr.kicker}</p>
          <h2 class="mt-3 text-[clamp(2.5rem,6vw,4.75rem)] leading-[0.95] font-extrabold tracking-[-0.04em]">{tr.title}</h2>
          <p class="mt-6 max-w-xl text-lg leading-8 text-muted">{cta}</p>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            <ShimmerLink href={`mailto:${email}`} class="max-w-full font-mono">
              <span class="truncate">{email}</span>
            </ShimmerLink>
            <button
              type="button"
              data-copy-email={email}
              class="rounded-full border border-line bg-surface px-5 py-3 text-sm font-semibold transition-colors hover:border-muted"
            >
              {tr.copy}
            </button>
          </div>

          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
            <ContactDock client:visible items={dockItems} />
            <span class="text-sm text-muted">{location}</span>
          </div>
        </div>

        <div class="relative mx-auto aspect-square w-full max-w-[22rem] lg:max-w-[24rem]">
          <ContactGlobe client:visible label={tr.globe} />
        </div>
      </div>
    </div>
  </Reveal>
</section>

<script>
  import { copyEmail } from '../../scripts/feedback';

  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLElement>('[data-copy-email]');
    if (button) copyEmail(button.dataset.copyEmail!);
  });
</script>
