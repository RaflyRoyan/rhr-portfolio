---
import type { CollectionEntry } from 'astro:content';
import SectionHeading from '../SectionHeading.astro';
import { UPDATE_CATEGORIES } from '../../content.config';

interface Props {
  updates: CollectionEntry<'updates'>[];
}

const { updates } = Astro.props;
const LIMIT = 6;
const tabs = [{ value: 'all', label: 'All' }, ...UPDATE_CATEGORIES.map((c) => ({ value: c, label: c }))];
const counts = Object.fromEntries(tabs.map((t) => [t.value, t.value === 'all' ? updates.length : updates.filter((u) => u.data.category === t.value).length]));
const formatMonth = (d: Date) => d.toLocaleDateString('id-ID', { month: 'short', year: 'numeric' });
---

<section id="updates" class="relative py-24 sm:py-32">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6" data-updates data-limit={LIMIT}>
    <SectionHeading title="Update terbaru" doodle="pencil" note="Catatan kerja, terbaru di atas." />

    <div class="-mx-4 overflow-x-auto px-4 sm:mx-0 sm:px-0" data-reveal>
      <div class="inline-flex gap-2" role="group" aria-label="Filter kategori">
        {
          tabs.map((tab) => (
            <button
              type="button"
              data-filter={tab.value}
              aria-pressed={tab.value === 'all' ? 'true' : 'false'}
              class="rounded-full border-2 border-ink bg-surface px-4 py-1.5 text-sm font-semibold whitespace-nowrap transition-colors hover:bg-surface-2 aria-pressed:bg-ink aria-pressed:text-canvas"
            >
              {tab.label}
              <span class="ml-1 font-mono text-xs opacity-60">{counts[tab.value]}</span>
            </button>
          ))
        }
      </div>
    </div>

    <!-- Timeline: garis di kiri (mobile) atau tengah (desktop); kartu selang-seling kiri/kanan lewat data-side -->
    <div class="relative mt-12">
      <span class="absolute top-0 bottom-0 left-[11px] w-0.5 bg-ink/20 lg:left-1/2 lg:-translate-x-1/2" aria-hidden="true"></span>
      <ol class="relative" data-updates-list>
        {
          updates.map((u, i) => (
            <li
              data-category={u.data.category}
              data-side={i % 2 ? 'right' : 'left'}
              hidden={i >= LIMIT}
              class="group grid grid-cols-[1.5rem_1fr] gap-x-4 pb-10 last:pb-0 lg:grid-cols-[1fr_4rem_1fr] lg:gap-x-0"
            >
              <span
                class="relative col-start-1 row-start-1 mt-1 flex size-6 items-center justify-center rounded-full border-2 border-ink bg-surface lg:col-start-2 lg:mx-auto lg:mt-6"
                aria-hidden="true"
              >
                <span class="size-2 rounded-full bg-accent"></span>
              </span>
              <time
                datetime={u.data.date.toISOString()}
                class="hand col-start-2 row-start-1 text-xl lg:col-start-3 lg:mt-5 lg:group-data-[side=right]:col-start-1 lg:group-data-[side=right]:text-right"
              >
                {formatMonth(u.data.date)}
              </time>
              <article class="col-start-2 row-start-2 mt-3 flex flex-col rounded-2xl border-2 border-ink bg-surface p-5 transition-[translate,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-[5px_5px_0_var(--ink)] sm:p-6 lg:col-start-1 lg:row-start-1 lg:mt-0 lg:group-data-[side=right]:col-start-3">
                <p class="flex flex-wrap items-center gap-2">
                  <span class="rounded-full bg-accent-soft px-2.5 py-0.5 font-mono text-[11px] text-accent">{u.data.category.toLowerCase()}</span>
                  {u.data.tech.slice(0, 3).map((t) => (
                    <span class="rounded-full border border-line px-2.5 py-0.5 font-mono text-[11px] text-muted">{t}</span>
                  ))}
                </p>
                <p class="mt-3 text-lg leading-snug font-bold sm:text-xl">{u.data.title}</p>
                <p class="mt-2 text-sm leading-6 text-muted">{u.data.summary}</p>
                {u.data.relatedProject && (
                  <a href={`/projects/${u.data.relatedProject.id}`} class="mt-4 text-sm font-semibold text-accent hover:underline">
                    Lihat project terkait
                  </a>
                )}
              </article>
            </li>
          ))
        }
      </ol>
    </div>

    <button
      type="button"
      data-show-all
      hidden={updates.length <= LIMIT}
      class="mt-8 rounded-lg border-2 border-ink bg-surface px-5 py-2.5 text-sm font-semibold shadow-[3px_3px_0_var(--ink)] transition-[translate,box-shadow] hover:-translate-y-0.5 hover:shadow-[5px_5px_0_var(--ink)]"
    >
      Lihat semua update
    </button>
  </div>
</section>

<script>
  import { onPageLoad, prefersReducedMotion } from '../../scripts/lifecycle';

  onPageLoad(() => {
    const root = document.querySelector<HTMLElement>('[data-updates]');
    if (!root) return;
    const limit = Number(root.dataset.limit);
    const items = [...root.querySelectorAll<HTMLElement>('[data-updates-list] > li')];
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const more = root.querySelector<HTMLButtonElement>('[data-show-all]')!;
    let filter = 'all';
    let expanded = false;

    const render = (animate: boolean) => {
      const matches = items.filter((li) => filter === 'all' || li.dataset.category === filter);
      items.forEach((li) => {
        const wasHidden = li.hidden;
        const index = matches.indexOf(li);
        li.hidden = index === -1 || (!expanded && index >= limit);
        // Sisi kartu timeline mengikuti urutan item yang terlihat, bukan urutan DOM
        if (index !== -1) li.dataset.side = index % 2 ? 'right' : 'left';
        li.classList.remove('enter');
        if (animate && !li.hidden && !prefersReducedMotion()) {
          // Paksa reflow supaya animasi bisa diputar ulang
          void li.offsetWidth;
          li.style.setProperty('--i', String(wasHidden ? index % limit : 0));
          li.classList.add('enter');
        }
      });
      more.hidden = expanded || matches.length <= limit;
    };

    root.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const tab = target.closest<HTMLButtonElement>('[data-filter]');
      if (tab) {
        filter = tab.dataset.filter!;
        tabs.forEach((t) => t.setAttribute('aria-pressed', String(t === tab)));
        render(true);
      } else if (target.closest('[data-show-all]')) {
        expanded = true;
        render(true);
      }
    });
  });
</script>
