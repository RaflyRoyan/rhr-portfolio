---
import { AnimatedGridPattern } from '@/components/ui/animated-grid-pattern';
import { AnimatedShinyText } from '@/components/ui/animated-shiny-text';
import { Particles } from '@/components/ui/particles';
import RoleRotate from '../islands/RoleRotate';
import Ticker from '../islands/Ticker';
import HeroTerminal from '../islands/HeroTerminal';
import ShimmerLink from '../ShimmerLink.astro';
import { getLang, getProfile, t } from '../../i18n';

interface Props {
  stats: { value: number; label: string }[];
}

const { stats } = Astro.props;
const lang = getLang(Astro.url);
const tr = t(lang).hero;
const profile = getProfile(lang);
const words = profile.name.split(' ');
const nameLines = [words.slice(0, 2).join(' '), words.slice(2).join(' ')].filter(Boolean);
const topSkills = Object.values(profile.skills).flat().slice(0, 4);
const terminalLines = [
  { command: tr.terminalCmd.whoami, output: profile.name },
  { command: tr.terminalCmd.role, output: `${profile.title}, ${profile.tagline}` },
  { command: tr.terminalCmd.where, output: profile.location },
  { command: tr.terminalCmd.stack, output: topSkills.join('  ') },
];
---

<section id="top" class="relative isolate overflow-hidden">
  <AnimatedGridPattern
    client:load
    numSquares={28}
    maxOpacity={0.12}
    duration={3}
    width={48}
    height={48}
    className="-z-10 fill-accent/30 stroke-line/70 motion-reduce:hidden [mask-image:radial-gradient(640px_circle_at_70%_30%,white,transparent)] inset-x-0 inset-y-[-20%] h-[140%]"
  />

  <div class="pointer-events-none absolute inset-0 -z-10 motion-reduce:hidden" aria-hidden="true">
    <Particles client:idle className="absolute inset-0" quantity={70} ease={70} size={0.5} color="#8b7dff" refresh={false} />
  </div>
  <span class="pointer-events-none absolute -top-40 left-1/2 -z-10 size-[44rem] -translate-x-1/2 rounded-full bg-[radial-gradient(circle,color-mix(in_oklab,var(--accent-from)_20%,transparent),transparent_65%)] blur-3xl" aria-hidden="true"></span>
  <div class="mx-auto w-full max-w-6xl px-4 pt-16 pb-24 sm:px-6 sm:pt-20 lg:pt-24 lg:pb-32">
    <div class="hero-in" style="--hero-delay: 0.05s">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <p class="inline-flex items-center gap-2 rounded-full border border-line bg-surface/80 px-3.5 py-1.5 text-xs font-medium backdrop-blur sm:text-sm">
          <span class="relative flex size-2">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-accent opacity-60 motion-reduce:hidden"></span>
            <span class="relative inline-flex size-2 rounded-full bg-accent"></span>
          </span>
          <AnimatedShinyText className="mx-0 max-w-none text-ink/80 dark:text-ink/80">{profile.currentPosition}</AnimatedShinyText>
        </p>
        <p class="font-mono text-xs text-muted sm:text-sm">{profile.location}</p>
      </div>
    </div>

    <div class="mt-12 grid gap-14 lg:mt-16 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-7">
        <div class="hero-in" style="--hero-delay: 0.12s">
          <h1 class="text-[clamp(2.9rem,8.5vw,6.5rem)] leading-[0.92] font-extrabold tracking-[-0.045em]">
            {
              nameLines.map((line, i) =>
                i === nameLines.length - 1 ? (
                  <span class="block bg-linear-to-r from-accent-from to-accent-to bg-clip-text pb-1 text-transparent">{line}</span>
                ) : (
                  <span class="block">{line}</span>
                ),
              )
            }
          </h1>
        </div>

        <div class="hero-in" style="--hero-delay: 0.2s">
          <p class="mt-6 flex flex-wrap items-baseline gap-x-2 text-xl font-semibold sm:text-2xl">
            <RoleRotate client:load words={tr.roles} className="inline-block text-ink" />
            <span class="text-muted">· {profile.tagline}</span>
          </p>
          <p class="mt-4 max-w-xl text-[1.0625rem] leading-7 text-muted">{profile.bio.short}</p>
        </div>

        <div class="hero-in" style="--hero-delay: 0.28s">
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <ShimmerLink href="#projects">{tr.viewProjects}</ShimmerLink>
            <a
              href="#contact"
              class="rounded-full border border-line bg-surface/70 px-6 py-3 text-sm font-semibold backdrop-blur transition-[translate,border-color] duration-300 hover:-translate-y-0.5 hover:border-muted"
            >
              {tr.contact}
            </a>
          </div>
        </div>

        <ul class="mt-12 grid max-w-lg grid-cols-3 gap-4" aria-label={tr.summary}>
          {
            stats.map(({ value, label }) => (
              <li class="rounded-2xl border border-line bg-surface/70 p-4 backdrop-blur">
                <Ticker client:visible value={value} className="block text-3xl font-bold tracking-tight tabular-nums sm:text-4xl" />
                <span class="mt-1 block text-xs text-muted sm:text-sm">{label}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lg:col-span-5 lg:pt-2">
        <HeroTerminal client:visible title={tr.terminalTitle} lines={terminalLines} />
      </div>
    </div>
  </div>
</section>
