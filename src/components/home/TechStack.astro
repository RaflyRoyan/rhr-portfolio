---
import type { CollectionEntry } from 'astro:content';
import SectionHeading from '../SectionHeading.astro';
import Doodle from '../Doodle.astro';
import { profile } from '../../data/profile';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;

// Nama skill di profil kadang beda dengan nama tech di project; alias menyamakan keduanya.
const ALIASES: Record<string, string[]> = {
  'oracle sql': ['oracle'],
  'pl/sql': ['pl/sql'],
  'entity framework core': ['ef core'],
  'asp.net core mvc/razor': ['asp.net core mvc', 'razor'],
  'background services': ['background services'],
  'payment / qris / va': ['va / qris'],
  'sse (server-sent events)': ['sse'],
  'materialized view': ['materialized view'],
  'query optimization': [],
};
const norm = (s: string) => s.toLowerCase().trim();

function projectsUsing(skill: string) {
  const key = norm(skill);
  const needles = ALIASES[key] ?? [key];
  return projects
    .filter((p) => p.data.tech.some((t) => needles.some((n) => norm(t) === n || norm(t).startsWith(`${n} `) || norm(t).endsWith(` ${n}`))))
    .map((p) => p.id);
}

// Tabel periodik: tiap skill jadi "elemen" dengan simbol dua huruf
const SYMBOLS: Record<string, string> = {
  'c#': 'C#',
  '.net': 'Nt',
  'asp.net core mvc/razor': 'As',
  'background services': 'Bg',
  'oracle sql': 'Or',
  'pl/sql': 'Pl',
  'entity framework core': 'Ef',
  dapper: 'Dp',
  'materialized view': 'Mv',
  'query optimization': 'Qo',
  javascript: 'Js',
  jquery: 'Jq',
  ajax: 'Ax',
  devextreme: 'Dx',
  'bootstrap 5': 'Bs',
  'tailwind css': 'Tw',
  'chart.js': 'Ch',
  'rest api': 'Ra',
  'database link': 'Dl',
  'payment / qris / va': 'Qr',
  'sse (server-sent events)': 'Se',
  'payment callback': 'Pc',
  'c# winforms': 'Wf',
  git: 'Gt',
  'visual studio': 'Vs',
  'oracle tools': 'Ot',
  'layered architecture': 'La',
  'repository/service pattern': 'Rp',
  'asynchronous processing': 'Ap',
};
const symbolOf = (name: string) => {
  const letters = name.replace(/[^a-z]/gi, '');
  return SYMBOLS[norm(name)] ?? letters.charAt(0).toUpperCase() + letters.charAt(1).toLowerCase();
};

// Warna golongan; urutan mengikuti profile.skills
const TONES = [
  'bg-accent-soft',
  'bg-note',
  'bg-surface',
  'bg-rose-100 dark:bg-rose-950/60',
  'bg-violet-100 dark:bg-violet-950/60',
  'bg-orange-100 dark:bg-orange-950/60',
  'bg-slate-200 dark:bg-slate-800',
];

let atomic = 0;
const groups = Object.entries(profile.skills).map(([group, skills], g) => ({
  group,
  tone: TONES[g % TONES.length],
  skills: skills.map((name) => ({ name, symbol: symbolOf(name), number: ++atomic, projects: projectsUsing(name) })),
}));
---

<section id="stack" class="relative border-y-2 border-ink bg-pen-soft py-24 sm:py-32">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6" data-stack>
    <SectionHeading title="Tabel periodik teknologi" doodle="braces" note="Klik satu elemen untuk melihat project yang memakainya." />

    <p class="hand -mt-6 mb-4 flex items-center gap-2 text-lg lg:hidden" aria-hidden="true">
      geser ke samping
      <Doodle name="arrow-right" class="h-4 w-8" />
    </p>

    <div class="-mx-4 overflow-x-auto px-4 pb-4 sm:-mx-6 sm:px-6" data-reveal>
      <div class="grid min-w-[54rem] grid-cols-7 items-start gap-2.5">
        {
          groups.map(({ group, tone, skills }) => (
            <div>
              <h3 class="hand mb-2 text-center text-lg font-bold">{group}</h3>
              <ul class="space-y-2.5">
                {skills.map(({ name, symbol, number, projects: used }) => (
                  <li>
                    <button
                      type="button"
                      aria-pressed="false"
                      aria-label={`${name}, dipakai di ${used.length} project`}
                      data-tech={name}
                      data-tech-symbol={symbol}
                      data-tech-group={group}
                      data-tech-number={number}
                      data-tech-projects={used.join(' ')}
                      class:list={[
                        'flex h-24 w-full flex-col justify-between rounded-lg border-2 border-ink p-2 text-left transition-[translate,box-shadow,background-color,color] duration-200 hover:-translate-y-0.5 hover:shadow-[3px_3px_0_var(--ink)] aria-pressed:bg-ink aria-pressed:text-canvas',
                        tone,
                      ]}
                    >
                      <span class="flex items-center justify-between font-mono text-[10px] opacity-70">
                        <span>{number}</span>
                        {used.length > 0 && <span title={`Dipakai di ${used.length} project`}>{used.length}×</span>}
                      </span>
                      <span class="text-2xl leading-none font-extrabold tracking-tight">{symbol}</span>
                      <span class="line-clamp-2 text-[10.5px] leading-tight font-medium">{name}</span>
                    </button>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Panel detail: elemen terpilih diperbesar + daftar project -->
    <div class="mt-8 grid gap-6 rounded-2xl border-2 border-ink bg-surface p-5 shadow-[5px_5px_0_var(--ink)] sm:p-6 md:grid-cols-[13rem_1fr] md:gap-8" data-reveal>
      <div class="flex aspect-square flex-col justify-between rounded-xl border-2 border-ink bg-note p-4 text-ink" aria-hidden="true">
        <span class="font-mono text-xs opacity-70" data-stack-number>—</span>
        <span class="text-7xl leading-none font-extrabold tracking-tight" data-stack-symbol>?</span>
        <span>
          <span class="block font-bold" data-stack-name>Pilih elemen</span>
          <span class="block text-xs opacity-70" data-stack-group>dari tabel di atas</span>
        </span>
      </div>
      <div>
        <p class="hand text-xl" aria-live="polite" data-stack-status>Semua project</p>
        <ul class="mt-3 grid gap-x-8 gap-y-0.5 sm:grid-cols-2">
          {
            projects.map((p) => (
              <li>
                <a
                  href={`/projects/${p.id}`}
                  data-stack-project={p.id}
                  class="flex items-center justify-between gap-3 rounded-md border-b border-dashed border-line px-1 py-2 text-sm transition-[opacity,color] duration-200 hover:text-accent data-[dim]:opacity-30 data-[hl]:font-semibold data-[hl]:text-accent"
                >
                  <span>{p.data.title}</span>
                  <span class="shrink-0 font-mono text-[11px] text-muted">{p.data.category}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  import { onPageLoad } from '../../scripts/lifecycle';

  // Hover/focus = pratinjau, klik = kunci pilihan
  onPageLoad(() => {
    const root = document.querySelector<HTMLElement>('[data-stack]');
    if (!root) return;
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-tech]')];
    const rows = [...root.querySelectorAll<HTMLElement>('[data-stack-project]')];
    const status = root.querySelector<HTMLElement>('[data-stack-status]')!;
    const field = (name: string) => root.querySelector<HTMLElement>(`[data-stack-${name}]`)!;
    const tile = { number: field('number'), symbol: field('symbol'), name: field('name'), group: field('group') };
    let pinned: HTMLButtonElement | null = null;

    const show = (chip: HTMLButtonElement | null) => {
      if (!chip) {
        rows.forEach((r) => {
          r.removeAttribute('data-dim');
          r.removeAttribute('data-hl');
        });
        status.textContent = 'Semua project';
        tile.number.textContent = '—';
        tile.symbol.textContent = '?';
        tile.name.textContent = 'Pilih elemen';
        tile.group.textContent = 'dari tabel di atas';
        return;
      }
      const ids = new Set(chip.dataset.techProjects!.split(' ').filter(Boolean));
      rows.forEach((r) => {
        const match = ids.has(r.dataset.stackProject!);
        r.toggleAttribute('data-hl', match);
        r.toggleAttribute('data-dim', !match);
      });
      status.textContent =
        ids.size > 0
          ? `${chip.dataset.tech}: dipakai di ${ids.size} project`
          : `${chip.dataset.tech}: belum tercatat di project mana pun`;
      tile.number.textContent = chip.dataset.techNumber!;
      tile.symbol.textContent = chip.dataset.techSymbol!;
      tile.name.textContent = chip.dataset.tech!;
      tile.group.textContent = chip.dataset.techGroup!;
    };

    const onClick = (event: Event) => {
      const chip = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-tech]');
      if (!chip) return;
      pinned = pinned === chip ? null : chip;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === pinned)));
      show(pinned);
    };
    const onEnter = (event: Event) => {
      const chip = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-tech]');
      if (chip) show(chip);
    };
    const onLeave = (event: Event) => {
      if ((event.target as HTMLElement).closest('[data-tech]')) show(pinned);
    };

    root.addEventListener('click', onClick);
    root.addEventListener('pointerover', onEnter);
    root.addEventListener('pointerout', onLeave);
    root.addEventListener('focusin', onEnter);
    root.addEventListener('focusout', onLeave);
  });
</script>
