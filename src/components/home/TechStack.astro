---
import type { CollectionEntry } from 'astro:content';
import { Marquee } from '@/components/ui/marquee';
import { IconCloud } from '@/components/ui/icon-cloud';
import SectionHeading from '../SectionHeading.astro';
import SectionGlow from '../SectionGlow.astro';
import Reveal from '../islands/Reveal';
import { skillIconImages } from '../../lib/skill-icons';
import { getLang, getProfile, localePath, t } from '../../i18n';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
const lang = getLang(Astro.url);
const tr = t(lang).stack;
const profile = getProfile(lang);

// Nama skill di profil kadang beda dengan nama tech di project; alias menyamakan keduanya.
const ALIASES: Record<string, string[]> = {
  'oracle sql': ['oracle'],
  'pl/sql': ['pl/sql'],
  'entity framework core': ['ef core'],
  'asp.net core mvc/razor': ['asp.net core mvc', 'razor'],
  'background services': ['background services'],
  'payment / qris / va': ['va / qris'],
  'sse (server-sent events)': ['sse'],
  'materialized view': ['materialized view'],
  'query optimization': [],
};
const norm = (s: string) => s.toLowerCase().trim();

function projectsUsing(skill: string) {
  const key = norm(skill);
  const needles = ALIASES[key] ?? [key];
  return projects
    .filter((p) => p.data.tech.some((t) => needles.some((n) => norm(t) === n || norm(t).startsWith(`${n} `) || norm(t).endsWith(` ${n}`))))
    .map((p) => p.id);
}

// Tabel periodik: tiap skill jadi "elemen" dengan simbol dua huruf
const SYMBOLS: Record<string, string> = {
  'c#': 'C#',
  '.net': 'Nt',
  'asp.net core mvc/razor': 'As',
  'background services': 'Bg',
  'oracle sql': 'Or',
  'pl/sql': 'Pl',
  'entity framework core': 'Ef',
  dapper: 'Dp',
  'materialized view': 'Mv',
  'query optimization': 'Qo',
  javascript: 'Js',
  jquery: 'Jq',
  ajax: 'Ax',
  devextreme: 'Dx',
  'bootstrap 5': 'Bs',
  'tailwind css': 'Tw',
  'chart.js': 'Ch',
  'rest api': 'Ra',
  'database link': 'Dl',
  'payment / qris / va': 'Qr',
  'sse (server-sent events)': 'Se',
  'c# winforms': 'Wf',
  git: 'Gt',
  'visual studio': 'Vs',
  'oracle tools': 'Ot',
};
const symbolOf = (name: string) => {
  const letters = name.replace(/[^a-z]/gi, '');
  return SYMBOLS[norm(name)] ?? letters.charAt(0).toUpperCase() + letters.charAt(1).toLowerCase();
};

// Warna golongan; urutan mengikuti profile.skills
// Warna titik golongan; urutan mengikuti profile.skills
const TONES = ['bg-accent', 'bg-cyan-500', 'bg-violet-400', 'bg-sky-500', 'bg-indigo-400', 'bg-teal-500', 'bg-zinc-400'];

let atomic = 0;
const groups = Object.entries(profile.skills).map(([group, skills], g) => ({
  group,
  tone: TONES[g % TONES.length],
  skills: skills.map((name) => ({ name, symbol: symbolOf(name), number: ++atomic, projects: projectsUsing(name) })),
}));
const allSkills = Object.values(profile.skills).flat();
const half = Math.ceil(allSkills.length / 2);
const rails = [allSkills.slice(0, half), allSkills.slice(half)];
const iconImages = skillIconImages(allSkills);
---

<section id="stack" class="relative isolate overflow-x-clip py-24 sm:py-32">
  <SectionGlow side="left" />
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6" data-stack data-label-all={tr.allProjects} data-label-pick={tr.pick} data-label-pick-hint={tr.pickHint} data-label-used={tr.statusUsed} data-label-none={tr.statusNone}>
    <SectionHeading eyebrow={`05 · ${t(lang).sections.stack}`} title={tr.title} note={tr.note} />

    <!-- Pita skill berjalan (Marquee) + awan ikon (IconCloud) -->
    <div class="mb-10 grid items-center gap-6 lg:grid-cols-[minmax(0,1fr)_22rem]">
      <div class="relative flex flex-col gap-3 overflow-hidden [mask-image:linear-gradient(to_right,transparent,white_12%,white_88%,transparent)]" aria-hidden="true">
        {
          rails.map((rail, r) => (
            <Marquee pauseOnHover reverse={r === 1} className="[--duration:38s] [--gap:0.75rem] p-1">
              {rail.map((skill) => (
                <span class="rounded-full border border-line bg-surface px-4 py-2 text-sm font-medium whitespace-nowrap shadow-(--shadow-sheet)">{skill}</span>
              ))}
            </Marquee>
          ))
        }
      </div>
      <div class="relative mx-auto hidden size-[22rem] lg:block" aria-hidden="true">
        <span class="absolute inset-10 rounded-full bg-[radial-gradient(circle,color-mix(in_oklab,var(--accent)_16%,transparent),transparent_70%)]" />
        <IconCloud client:visible images={iconImages} />
      </div>
    </div>

    <div class="grid gap-6 lg:grid-cols-[1fr_20rem] lg:items-start lg:gap-10">
      <!-- Golongan sebagai baris; elemen mengalir sebagai chip -->
      <dl class="divide-y divide-line rounded-2xl border border-line bg-surface/80 px-5 backdrop-blur sm:px-6">
        {
          groups.map(({ group, tone, skills }) => (
            <div class="grid gap-3 py-5 sm:grid-cols-[9rem_1fr] sm:gap-6">
              <dt class="flex items-center gap-2 sm:pt-1.5">
                <span class:list={['size-2.5 shrink-0 rounded-full', tone]} aria-hidden="true" />
                <span class="text-sm font-semibold">{group}</span>
              </dt>
              <dd>
                <ul class="flex flex-wrap gap-2">
                  {skills.map(({ name, symbol, number, projects: used }) => (
                    <li>
                      <button
                        type="button"
                        aria-pressed="false"
                        aria-label={tr.usedIn(name, used.length)}
                        data-tech={name}
                        data-tech-symbol={symbol}
                        data-tech-group={group}
                        data-tech-number={number}
                        data-tech-projects={used.join(' ')}
                        class="group inline-flex items-center gap-2 rounded-full border border-line bg-canvas py-1 pr-3 pl-1 text-sm transition-[translate,border-color,background-color,color] duration-200 hover:-translate-y-0.5 hover:border-ink aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-canvas"
                      >
                        <span
                          class:list={[
                            'grid size-7 shrink-0 place-items-center rounded-full border border-line bg-surface-2 font-mono text-[11px] font-bold text-ink',
                          ]}
                          aria-hidden="true"
                        >
                          {symbol}
                        </span>
                        <span class="font-medium">{name}</span>
                        {used.length > 0 && (
                          <span class="font-mono text-[10px] text-muted group-aria-pressed:text-canvas/70" aria-hidden="true">
                            {used.length}×
                          </span>
                        )}
                      </button>
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>

      <!-- Panel detail: elemen terpilih + daftar project -->
      <aside class="rounded-2xl border border-line bg-surface/80 p-5 backdrop-blur lg:sticky lg:top-24">
        <div class="flex items-center gap-4">
          <div class="flex size-20 shrink-0 flex-col justify-between rounded-2xl bg-linear-to-br from-accent-from to-accent-to p-2.5 text-white" aria-hidden="true">
            <span class="font-mono text-[10px] opacity-70" data-stack-number>—</span>
            <span class="text-3xl leading-none font-extrabold tracking-tight" data-stack-symbol>?</span>
          </div>
          <div class="min-w-0">
            <span class="block truncate font-bold" data-stack-name>{tr.pick}</span>
            <span class="block text-xs text-muted" data-stack-group>{tr.pickHint}</span>
          </div>
        </div>
        <p class="mt-5 text-sm font-semibold" aria-live="polite" data-stack-status>{tr.allProjects}</p>
        <ul class="mt-2">
          {
            projects.map((p) => (
              <li>
                <a
                  href={localePath(lang, `/projects/${p.id}`)}
                  data-stack-project={p.id}
                  class="flex items-center justify-between gap-3 border-b border-line px-1 py-2 text-sm transition-[opacity,color] duration-200 hover:text-accent data-[dim]:opacity-30 data-[hl]:font-semibold data-[hl]:text-accent"
                >
                  <span>{p.data.title}</span>
                  <span class="shrink-0 font-mono text-[11px] text-muted">{p.data.category}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </div>
</section>

<script>
  import { onPageLoad } from '../../scripts/lifecycle';

  // Hover/focus = pratinjau, klik = kunci pilihan
  onPageLoad(() => {
    const root = document.querySelector<HTMLElement>('[data-stack]');
    if (!root) return;
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-tech]')];
    const rows = [...root.querySelectorAll<HTMLElement>('[data-stack-project]')];
    const status = root.querySelector<HTMLElement>('[data-stack-status]')!;
    const field = (name: string) => root.querySelector<HTMLElement>(`[data-stack-${name}]`)!;
    const tile = { number: field('number'), symbol: field('symbol'), name: field('name'), group: field('group') };
    // Teks status diambil dari atribut data-label-* supaya mengikuti bahasa halaman
    const label = root.dataset;
    let pinned: HTMLButtonElement | null = null;

    const show = (chip: HTMLButtonElement | null) => {
      if (!chip) {
        rows.forEach((r) => {
          r.removeAttribute('data-dim');
          r.removeAttribute('data-hl');
        });
        status.textContent = label.labelAll!;
        tile.number.textContent = '—';
        tile.symbol.textContent = '?';
        tile.name.textContent = label.labelPick!;
        tile.group.textContent = label.labelPickHint!;
        return;
      }
      const ids = new Set(chip.dataset.techProjects!.split(' ').filter(Boolean));
      rows.forEach((r) => {
        const match = ids.has(r.dataset.stackProject!);
        r.toggleAttribute('data-hl', match);
        r.toggleAttribute('data-dim', !match);
      });
      status.textContent = (ids.size > 0 ? label.labelUsed! : label.labelNone!)
        .replace('{tech}', chip.dataset.tech!)
        .replace('{n}', String(ids.size));
      tile.number.textContent = chip.dataset.techNumber!;
      tile.symbol.textContent = chip.dataset.techSymbol!;
      tile.name.textContent = chip.dataset.tech!;
      tile.group.textContent = chip.dataset.techGroup!;
    };

    const onClick = (event: Event) => {
      const chip = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-tech]');
      if (!chip) return;
      pinned = pinned === chip ? null : chip;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === pinned)));
      show(pinned);
    };
    const onEnter = (event: Event) => {
      const chip = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-tech]');
      if (chip) show(chip);
    };
    const onLeave = (event: Event) => {
      if ((event.target as HTMLElement).closest('[data-tech]')) show(pinned);
    };

    root.addEventListener('click', onClick);
    root.addEventListener('pointerover', onEnter);
    root.addEventListener('pointerout', onLeave);
    root.addEventListener('focusin', onEnter);
    root.addEventListener('focusout', onLeave);
  });
</script>
