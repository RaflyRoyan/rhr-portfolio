---
import { getLang, t } from '../i18n';

const tr = t(getLang(Astro.url));
---

<button
  type="button"
  data-theme-toggle
  aria-label={tr.nav.theme}
  class="rounded-md p-2 text-muted transition-colors hover:bg-surface-2 hover:text-ink"
>
  <!-- Ikon matahari tampil di dark mode, bulan di light mode -->
  <svg class="hidden size-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
  </svg>
  <svg class="block size-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<script>
  import { toggleTheme } from '../scripts/theme';

  // Delegasi event: tetap jalan setelah navigasi ClientRouter tanpa re-bind
  document.addEventListener('click', (event) => {
    const target = event.target as Element | null;
    if (target?.closest('[data-theme-toggle]')) toggleTheme();
  });
</script>
