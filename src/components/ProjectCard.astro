---
import type { CollectionEntry } from 'astro:content';
import ProjectCover from './ProjectCover.astro';
import ProjectStatus from './ProjectStatus.astro';
import GlowCard from './islands/GlowCard';
import { getLang, localePath, t } from '../i18n';

interface Props {
  project: CollectionEntry<'projects'>;
  class?: string;
}

const { project, class: className } = Astro.props;
const { title, summary, category, status, tech, featured, cover } = project.data;
const maxChips = featured ? 6 : 4;
const shown = tech.slice(0, maxChips);
const rest = tech.length - shown.length;
const lang = getLang(Astro.url);
---

<GlowCard client:visible className={['h-full transition-opacity', className].filter(Boolean).join(' ')}>
  <a href={localePath(lang, `/projects/${project.id}`)} data-project={project.id} class="group flex h-full flex-col gap-4 p-3">
    <ProjectCover project={project} />
    <div class="flex flex-1 flex-col px-2 pb-2">
      <div class="flex items-center justify-between gap-3">
        <span class="font-mono text-xs text-muted">{category}</span>
        {cover && <ProjectStatus status={status} />}
      </div>
      <h3 class="mt-2 text-xl font-bold tracking-tight transition-colors group-hover:text-accent" transition:name={`project-title-${project.id}`}>
        <span>{title}</span>
      </h3>
      <p class="mt-2 text-sm leading-6 text-muted">{summary}</p>
      {
        shown.length > 0 && (
          <ul class="mt-auto flex flex-wrap gap-1.5 pt-4" aria-label={t(lang).projects.tech} transition:name={`project-tech-${project.id}`}>
            {shown.map((item) => (
              <li class="rounded-md border border-line bg-surface-2 px-1.5 py-0.5 font-mono text-[11px] text-muted">{item}</li>
            ))}
            {rest > 0 && <li class="px-1 py-0.5 font-mono text-[11px] text-muted">+{rest}</li>}
          </ul>
        )
      }
    </div>
  </a>
</GlowCard>
