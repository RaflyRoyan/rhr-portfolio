---
import type { CollectionEntry } from 'astro:content';
import ProjectCover from './ProjectCover.astro';
import ProjectStatus from './ProjectStatus.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  class?: string;
}

const { project, class: className } = Astro.props;
const { title, summary, category, status, tech, featured, cover } = project.data;
const maxChips = featured ? 6 : 4;
const shown = tech.slice(0, maxChips);
const rest = tech.length - shown.length;
---

<a
  href={`/projects/${project.id}`}
  data-project={project.id}
  class:list={[
    'sheet lift group flex flex-col gap-4 rounded-3xl p-3 data-[dim]:opacity-35 data-[hl]:border-accent',
    className,
  ]}
>
  <ProjectCover project={project} />
  <div class="flex flex-1 flex-col px-1 pb-1">
    <div class="flex items-center justify-between gap-3">
      <span class="font-mono text-xs text-muted">{category}</span>
      {cover && <ProjectStatus status={status} />}
    </div>
    <h3 class="mt-2 text-xl font-bold tracking-tight group-hover:text-accent" transition:name={`project-title-${project.id}`}>
      <span>{title}</span>
    </h3>
    <p class="mt-2 text-sm leading-6 text-muted">{summary}</p>
    {
      shown.length > 0 && (
        <ul class="mt-auto flex flex-wrap gap-1.5 pt-4" aria-label="Teknologi" transition:name={`project-tech-${project.id}`}>
          {shown.map((item) => (
            <li class="rounded border border-line px-1.5 py-0.5 font-mono text-[11px] text-muted">{item}</li>
          ))}
          {rest > 0 && <li class="px-1 py-0.5 font-mono text-[11px] text-muted">+{rest}</li>}
        </ul>
      )
    }
  </div>
</a>
