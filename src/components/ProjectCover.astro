---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { ChartColumn, Boxes, Database, MapPin, Plug, ScanSearch, Server } from 'lucide-react';
import ProjectStatus from './ProjectStatus.astro';
import { getLang, t } from '../i18n';

interface Props {
  project: CollectionEntry<'projects'>;
  size?: 'card' | 'page';
  class?: string;
}

// Ikon pengganti gambar, per kategori project
const CATEGORY_ICON = {
  Backend: Server,
  Database: Database,
  Dashboard: ChartColumn,
  'Monitoring System': ScanSearch,
  Integration: Plug,
  Migration: Boxes,
  'Field Ops': MapPin,
} satisfies Record<CollectionEntry<'projects'>['data']['category'], unknown>;

const { project, size = 'card', class: className } = Astro.props;
const { cover, title, status, category } = project.data;
const name = `project-cover-${project.id}`;
const height = size === 'page' ? 'h-36 sm:h-52' : 'h-28 sm:h-32';
const Icon = CATEGORY_ICON[category];
---

{
  cover ? (
    <Image src={cover} alt={`${t(getLang(Astro.url)).projects.coverAlt} ${title}`} class:list={['w-full rounded-xl object-cover', height, className]} transition:name={name} />
  ) : (
    // Cover otomatis bila belum ada gambar: panel grid berisi path, status, dan ikon kategori
    <div
      class:list={['cover-grid relative w-full overflow-hidden rounded-xl border border-line bg-surface-2', height, className]}
      transition:name={name}
    >
      <span class="absolute inset-0 bg-[radial-gradient(circle_at_85%_50%,color-mix(in_oklab,var(--accent)_18%,transparent),transparent_60%)]" aria-hidden="true" />
      <span class="absolute top-3 left-3 font-mono text-xs text-muted" aria-hidden="true">~/projects/{project.id}</span>
      <span class="absolute bottom-3 left-3 rounded-md border border-line bg-surface px-1.5 py-0.5">
        <ProjectStatus status={status} />
      </span>
      <Icon
        className={['absolute top-1/2 right-6 -translate-y-1/2 text-accent', size === 'page' ? 'size-20 sm:size-28' : 'size-12 sm:size-14'].join(' ')}
        strokeWidth={1.25}
        aria-hidden="true"
      />
    </div>
  )
}
