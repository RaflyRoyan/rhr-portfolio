const { name, class: className, stroke = 3, delay = 0, draw = true } = Astro.props;
const doodle = DOODLES[name];
// Garis bawah & lingkaran mengikuti ukuran elemen yang dicoret, bukan rasio viewBox
const stretch = name === 'underline' || name === 'circle';
---

<svg
  viewBox={doodle.box}
  preserveAspectRatio={stretch ? 'none' : undefined}
  class:list={['doodle', className]}
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  data-draw={draw ? '' : undefined}
  style={delay ? `--draw-delay: ${delay}s` : undefined}
>
  {doodle.paths.map((d, i) => <path d={d} pathLength="1" style={`--i: ${i}`} />)}
</svg>
