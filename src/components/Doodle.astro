---
// Coretan tangan (SVG stroke). Setiap path tergambar saat masuk viewport lewat [data-draw]
// (lihat global.css); filter #sketchy di BaseLayout membuat garisnya sedikit bergelombang.
export type DoodleName = keyof typeof DOODLES;

interface Props {
  name: DoodleName;
  class?: string;
  /** Tebal garis dalam satuan viewBox. */
  stroke?: number;
  /** Jeda sebelum mulai menggambar, dalam detik. */
  delay?: number;
  /** false = tampil langsung tanpa animasi gambar. */
  draw?: boolean;
}

