---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  /** Varian mobile dibungkus <details> supaya tidak memakan layar. */
  variant: 'sidebar' | 'inline';
}

const { headings, variant } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 0 &&
    (variant === 'sidebar' ? (
      <nav aria-label="Daftar isi">
        <p class="font-mono text-xs text-muted">Di halaman ini</p>
        <ol class="mt-3 space-y-0.5 border-l border-line text-sm">
          {items.map((h) => (
            <li>
              <a
                href={`#${h.slug}`}
                data-toc-link={h.slug}
                class:list={[
                  '-ml-px block border-l border-transparent py-1 text-muted transition-colors hover:text-ink aria-[current]:border-accent aria-[current]:text-accent',
                  h.depth === 3 ? 'pl-7' : 'pl-4',
                ]}
              >
                {h.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    ) : (
      <details class="rounded-xl border border-line bg-surface">
        <summary class="cursor-pointer px-4 py-3 text-sm font-medium">Daftar isi</summary>
        <ol class="space-y-1 border-t border-line px-4 py-3 text-sm">
          {items.map((h) => (
            <li class:list={[h.depth === 3 && 'pl-4']}>
              <a href={`#${h.slug}`} class="block py-1 text-muted hover:text-accent">
                {h.text}
              </a>
            </li>
          ))}
        </ol>
      </details>
    ))
}

<script>
  import { onPageLoad } from '../../scripts/lifecycle';

  // Sorot heading yang sedang dibaca
  onPageLoad(() => {
    const links = new Map<string, HTMLElement>();
    document.querySelectorAll<HTMLElement>('[data-toc-link]').forEach((a) => links.set(a.dataset.tocLink!, a));
    if (links.size === 0) return;
    const headings = [...links.keys()].map((id) => document.getElementById(id)).filter((el): el is HTMLElement => !!el);

    const setActive = (id: string) =>
      links.forEach((a, key) => (key === id ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));

    const io = new IntersectionObserver(
      (entries) => {
        // Heading paling atas yang sudah melewati garis 30% viewport
        const visible = entries.filter((e) => e.isIntersecting).map((e) => e.target.id);
        if (visible.length > 0) setActive(visible[0]);
      },
      { rootMargin: '0px 0px -70% 0px' },
    );
    headings.forEach((h) => io.observe(h));
    setActive(headings[0].id);
    return () => io.disconnect();
  });
</script>
