---
import Reveal from './islands/Reveal';

interface Props {
  title: string;
  /** Satu kalimat penjelas di bawah judul. */
  note?: string;
  /** Label kecil di atas judul (mis. nomor atau kategori section). */
  eyebrow?: string;
}

const { title, note, eyebrow } = Astro.props;
---

<Reveal client:visible className="mb-12 max-w-2xl">
  {
    eyebrow && (
      <p class="mb-3 inline-flex items-center gap-2 rounded-full border border-line bg-surface/70 px-3 py-1 font-mono text-xs text-muted">
        <span class="size-1.5 rounded-full bg-linear-to-r from-accent-from to-accent-to" aria-hidden="true" />
        {eyebrow}
      </p>
    )
  }
  <h2 class="text-3xl font-bold tracking-tight text-balance sm:text-5xl">{title}</h2>
  {note && <p class="mt-4 text-lg leading-7 text-muted">{note}</p>}
</Reveal>
