---
interface Props {
  title: string;
  /** Satu kalimat penjelas, tampil sebagai komentar kode di bawah judul. */
  note?: string;
}

const { title, note } = Astro.props;
---

<div class="mb-10 max-w-2xl" data-reveal>
  <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">{title}</h2>
  {note && <p class="mt-3 font-mono text-sm text-muted"><span class="text-accent/70">//</span> {note}</p>}
</div>
