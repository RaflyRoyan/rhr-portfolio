---
interface Props {
  title: string;
  href?: string;
  linkLabel?: string;
}

const { title, href, linkLabel = 'Lihat semua' } = Astro.props;
---

<div class="mb-6 flex items-baseline justify-between gap-4">
  <h2 class="font-mono text-sm font-semibold tracking-wider text-zinc-500 uppercase dark:text-zinc-400">{title}</h2>
  {
    href && (
      <a href={href} class="text-sm text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100">
        {linkLabel} →
      </a>
    )
  }
</div>
