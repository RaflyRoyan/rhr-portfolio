---
import '@fontsource-variable/bricolage-grotesque/standard.css';
import '@fontsource/kalam/400.css';
import '@fontsource/kalam/700.css';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
import { SITE } from '../consts';
import { LANGS, getLang, getProfile, switchPath, t } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const lang = getLang(Astro.url);
const { title, description = getProfile(lang).bio.short, image = SITE.ogImage } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.title}` : `${SITE.title}, Backend Developer`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(switchPath(Astro.url.pathname, l), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(switchPath(Astro.url.pathname, 'id'), Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'id_ID'} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Terapkan tema + flag .js sebelum paint supaya tidak flash; diterapkan ulang setelah swap ClientRouter.
         Kunjungan baru selalu terang; pilihan dark dari toggle hanya bertahan selama sesi tab (sessionStorage). -->
    <script is:inline>
      (() => {
        const apply = () => {
          let stored = null;
          try {
            stored = sessionStorage.getItem('rhr-theme');
          } catch {}
          document.documentElement.classList.toggle('dark', stored === 'dark');
          document.documentElement.classList.add('js');
        };
        apply();
        if (!window.__themeInit) {
          window.__themeInit = true;
          document.addEventListener('astro:after-swap', apply);
        }
      })();
    </script>

    <ClientRouter />
  </head>
  <body class="flex min-h-dvh flex-col font-sans">
    <!-- Filter garis tangan untuk semua .doodle -->
    <svg width="0" height="0" class="absolute" aria-hidden="true">
      <filter id="sketchy">
        <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="7"></feTurbulence>
        <feDisplacementMap in="SourceGraphic" scale="2.4"></feDisplacementMap>
      </filter>
    </svg>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-accent focus:px-3 focus:py-2 focus:text-accent-ink"
      >{t(lang).skipToContent}</a
    >
    <Navbar />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <CommandPalette />
    <div
      id="toast"
      role="status"
      aria-live="polite"
      data-open="false"
      class="pointer-events-none fixed bottom-5 left-1/2 z-50 -translate-x-1/2 rounded-md border border-line bg-surface px-4 py-2.5 font-mono text-sm text-ink shadow-lg transition-all duration-300 data-[open=false]:translate-y-3 data-[open=false]:opacity-0 motion-reduce:transition-none"
    >
    </div>
  </body>
</html>

<script>
  import { onPageLoad, prefersReducedMotion } from '../scripts/lifecycle';

  // Reveal on scroll untuk semua elemen [data-reveal] dan coretan [data-draw]
  onPageLoad(() => {
    const items = document.querySelectorAll<HTMLElement>('[data-reveal], [data-draw]');
    if (prefersReducedMotion() || !('IntersectionObserver' in window)) {
      items.forEach((el) => el.classList.add('is-visible'));
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        // Elemen yang masuk bersamaan muncul bertahap; jeda dihapus setelahnya supaya hover tidak ikut tertunda
        let order = 0;
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          if (el.hasAttribute('data-reveal') && order > 0) {
            el.style.setProperty('--reveal-delay', `${Math.min(order, 6) * 80}ms`);
            el.addEventListener('transitionend', () => el.style.removeProperty('--reveal-delay'), { once: true });
          }
          if (el.hasAttribute('data-reveal')) order++;
          el.classList.add('is-visible');
          io.unobserve(el);
        }
      },
      { rootMargin: '0px 0px -10% 0px' },
    );
    items.forEach((el) => io.observe(el));
    return () => io.disconnect();
  });
</script>
