---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import About from '../components/home/About.astro';
import Services from '../components/home/Services.astro';
import FeaturedProjects from '../components/home/FeaturedProjects.astro';
import Experience from '../components/home/Experience.astro';
import TechStack from '../components/home/TechStack.astro';
import Updates from '../components/home/Updates.astro';
import Education from '../components/home/Education.astro';
import Contact from '../components/home/Contact.astro';
import { getProjects, getUpdates } from '../lib/collections';
import { profile } from '../data/profile';

const projects = await getProjects();
const updates = await getUpdates();

const stats = [
  { value: projects.length, label: 'project' },
  { value: updates.length, label: 'update' },
  { value: profile.certifications.length, label: 'sertifikasi' },
];
---

<BaseLayout>
  <Hero stats={stats} />
  <About />
  <Services />
  <FeaturedProjects projects={projects} />
  <Experience />
  <TechStack projects={projects} />
  <Updates updates={updates} />
  <Education />
  <Contact />
</BaseLayout>
