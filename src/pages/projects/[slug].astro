---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getProjects } from '../../lib/collections';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { title, description, date, stack, cover, repo, demo } = project.data;
const { Content } = await render(project);
---

<BaseLayout title={title} description={description}>
  <article>
    <a href="/projects" class="text-sm text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100">← Projects</a>
    <header class="mt-6 mb-10">
      <h1 class="text-3xl font-bold tracking-tight" transition:name={`project-title-${project.id}`}>{title}</h1>
      <p class="mt-3 text-zinc-600 dark:text-zinc-400">{description}</p>
      <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-xs text-zinc-500">
        <FormattedDate date={date} />
        {stack.length > 0 && <span>{stack.join(' · ')}</span>}
        {repo && <a href={repo} class="underline hover:text-zinc-900 dark:hover:text-zinc-100">Repo</a>}
        {demo && <a href={demo} class="underline hover:text-zinc-900 dark:hover:text-zinc-100">Demo</a>}
      </div>
    </header>
    {cover && <Image src={cover} alt="" class="mb-10 rounded-lg" />}
    <div class="space-y-4 leading-7">
      <Content />
    </div>
  </article>
</BaseLayout>
