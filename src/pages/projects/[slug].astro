---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCover from '../../components/ProjectCover.astro';
import ProjectStatus from '../../components/ProjectStatus.astro';
import Toc from '../../components/project/Toc.astro';
import Highlights from '../../components/project/Highlights.astro';
import Gallery from '../../components/project/Gallery.astro';
import { categorySlug, getProjects, getUpdates } from '../../lib/collections';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  const updates = await getUpdates();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[i - 1],
      next: projects[i + 1],
      related: updates.filter((u) => u.data.relatedProject?.id === project.id),
    },
  }));
}) satisfies GetStaticPaths;

const { project, prev, next, related } = Astro.props;
const { title, summary, category, role, period, status, tech, highlights, gallery } = project.data;
const { Content, headings } = await render(project);
const formatMonth = (d: Date) => d.toLocaleDateString('id-ID', { month: 'short', year: 'numeric' });
---

<BaseLayout title={title} description={summary}>
  <div class="mx-auto w-full max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
    <a href="/#projects" class="font-mono text-sm text-muted hover:text-accent">cd ..</a>

    <div class="mt-6 grid gap-12 lg:grid-cols-[minmax(0,1fr)_17rem] lg:gap-16">
      <div class="min-w-0 max-w-3xl">
        <!-- Header: cover, judul, dan tech chips berbagi transition:name dengan kartu -->
        <header>
          <ProjectCover project={project} size="page" />
          <h1 class="mt-8 text-3xl font-semibold tracking-tight text-balance sm:text-4xl" transition:name={`project-title-${project.id}`}>
            <span>{title}</span>
          </h1>
          <p class="mt-4 text-lg leading-8 text-muted">{summary}</p>

          <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-4 border-y border-line py-5 sm:grid-cols-4">
            <div>
              <dt class="font-mono text-xs text-muted">Kategori</dt>
              <dd class="mt-1 text-sm">
                <a href={`/projects?kategori=${categorySlug(category)}`} class="hover:text-accent">{category}</a>
              </dd>
            </div>
            <div>
              <dt class="font-mono text-xs text-muted">Status</dt>
              <dd class="mt-1"><ProjectStatus status={status} /></dd>
            </div>
            <div>
              <dt class="font-mono text-xs text-muted">Periode</dt>
              <dd class="mt-1 text-sm">{period}</dd>
            </div>
            <div>
              <dt class="font-mono text-xs text-muted">Peran</dt>
              <dd class="mt-1 text-sm">{role}</dd>
            </div>
          </dl>

          {
            tech.length > 0 && (
              <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Teknologi" transition:name={`project-tech-${project.id}`}>
                {tech.map((item) => (
                  <li class="rounded border border-line px-2 py-0.5 font-mono text-xs text-muted">{item}</li>
                ))}
              </ul>
            )
          }
        </header>

        <!-- Mobile: daftar isi + sorotan di atas body (sidebar disembunyikan) -->
        <div class="mt-10 space-y-4 lg:hidden">
          <Toc headings={headings} variant="inline" />
          <Highlights items={highlights} class="rounded-xl border border-line bg-surface p-5" />
        </div>

        <article class="prose-project mt-12">
          <Content />
        </article>

        {gallery && gallery.length > 0 && <Gallery images={gallery} title={title} />}

        {
          related.length > 0 && (
            <section aria-labelledby="related-heading" class="mt-16">
              <h2 id="related-heading" class="text-xl font-semibold tracking-tight">
                Update terkait
              </h2>
              <ol class="mt-6 divide-y divide-line border-y border-line">
                {related.map((u) => (
                  <li class="grid gap-x-6 gap-y-1 py-5 sm:grid-cols-[6rem_1fr]">
                    <time datetime={u.data.date.toISOString()} class="font-mono text-xs leading-6 text-muted">
                      {formatMonth(u.data.date)}
                    </time>
                    <div>
                      <p class="flex flex-wrap items-baseline gap-x-3">
                        <span class="font-medium">{u.data.title}</span>
                        <span class="font-mono text-xs text-accent">{u.data.category.toLowerCase()}</span>
                      </p>
                      <p class="mt-1.5 text-sm leading-6 text-muted">{u.data.summary}</p>
                    </div>
                  </li>
                ))}
              </ol>
            </section>
          )
        }
      </div>

      <aside class="hidden lg:block">
        <div class="sticky top-24 space-y-10">
          <Toc headings={headings} variant="sidebar" />
          <Highlights items={highlights} />
        </div>
      </aside>
    </div>

    <nav aria-label="Project lain" class="mt-16 border-t border-line pt-8">
      <div class="grid gap-3 sm:grid-cols-2">
        {
          prev ? (
            <a href={`/projects/${prev.id}`} class="rounded-xl border border-line p-5 transition-colors hover:border-muted">
              <span class="font-mono text-xs text-muted">‹ Sebelumnya</span>
              <span class="mt-1 block font-medium">{prev.data.title}</span>
            </a>
          ) : (
            <span class="hidden sm:block" />
          )
        }
        {
          next && (
            <a href={`/projects/${next.id}`} class="rounded-xl border border-line p-5 text-right transition-colors hover:border-muted">
              <span class="font-mono text-xs text-muted">Berikutnya ›</span>
              <span class="mt-1 block font-medium">{next.data.title}</span>
            </a>
          )
        }
      </div>
      <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm">
        <a href="/#projects" class="font-medium text-accent hover:underline">Kembali ke beranda</a>
        <a href="/projects" class="text-muted hover:text-ink">Lihat semua project</a>
      </div>
    </nav>
  </div>
</BaseLayout>
