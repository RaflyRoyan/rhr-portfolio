---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { PROJECT_CATEGORIES } from '../../content.config';
import { categorySlug, getProjects } from '../../lib/collections';

const projects = await getProjects();
const filters = [
  { slug: '', label: 'Semua', count: projects.length },
  ...PROJECT_CATEGORIES.map((c) => ({
    slug: categorySlug(c),
    label: c,
    count: projects.filter((p) => p.data.category === c).length,
  })).filter((f) => f.count > 0),
];
---

<BaseLayout title="Projects" description="Project backend, database, dan dashboard yang pernah saya kerjakan.">
  <div class="mx-auto w-full max-w-6xl px-4 py-14 sm:px-6 sm:py-20" data-project-filter>
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Semua project</h1>
    <p class="mt-3 max-w-xl text-muted">Sistem internal Bapenda Kota Surabaya. Detail sensitif sengaja disamarkan.</p>

    <div class="mt-10 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
      <div class="-mx-4 overflow-x-auto px-4 sm:mx-0 sm:px-0">
        <div class="inline-flex gap-1 rounded-lg border border-line bg-surface p-1" role="group" aria-label="Filter kategori">
          {
            filters.map((f) => (
              <button
                type="button"
                data-category-filter={f.slug}
                aria-pressed={f.slug === '' ? 'true' : 'false'}
                class="rounded-md px-3 py-1.5 text-sm whitespace-nowrap text-muted transition-colors hover:text-ink aria-pressed:bg-surface-2 aria-pressed:text-ink"
              >
                {f.label}
                <span class="ml-1 font-mono text-xs text-muted">{f.count}</span>
              </button>
            ))
          }
        </div>
      </div>

      <label class="relative block lg:w-72">
        <span class="sr-only">Cari project</span>
        <span class="pointer-events-none absolute top-1/2 left-3 -translate-y-1/2 font-mono text-sm text-accent" aria-hidden="true">❯</span>
        <input
          type="search"
          data-project-search
          placeholder="Cari judul atau teknologi"
          autocomplete="off"
          class="w-full rounded-lg border border-line bg-surface py-2 pr-3 pl-8 font-mono text-sm outline-none placeholder:text-muted focus:border-accent"
        />
      </label>
    </div>

    <p class="mt-6 font-mono text-xs text-muted" aria-live="polite" data-project-count>{projects.length} project</p>

    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((project) => (
          <div
            class="flex"
            data-project-item
            data-category={categorySlug(project.data.category)}
            data-search={[project.data.title, project.data.summary, project.data.category, ...project.data.tech].join(' ').toLowerCase()}
          >
            <ProjectCard project={project} class="w-full" />
          </div>
        ))
      }
    </div>

    <div data-project-empty hidden class="mt-4 rounded-xl border border-dashed border-line p-10 text-center">
      <p class="text-muted">Tidak ada project yang cocok dengan filter ini.</p>
      <button type="button" data-project-reset class="mt-4 rounded-md border border-line px-4 py-2 text-sm font-medium hover:border-muted">
        Hapus filter
      </button>
    </div>
  </div>
</BaseLayout>

<script>
  import { onPageLoad } from '../../scripts/lifecycle';

  // Filter kategori + pencarian, disinkronkan ke query URL (?kategori=backend&q=oracle)
  onPageLoad(() => {
    const root = document.querySelector<HTMLElement>('[data-project-filter]');
    if (!root) return;
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-category-filter]')];
    const input = root.querySelector<HTMLInputElement>('[data-project-search]')!;
    const items = [...root.querySelectorAll<HTMLElement>('[data-project-item]')];
    const count = root.querySelector<HTMLElement>('[data-project-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-project-empty]')!;
    const valid = new Set(buttons.map((b) => b.dataset.categoryFilter));

    const params = new URLSearchParams(window.location.search);
    let category = valid.has(params.get('kategori') ?? '') ? params.get('kategori')! : '';
    input.value = params.get('q') ?? '';

    const apply = () => {
      const words = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      items.forEach((item) => {
        const match =
          (category === '' || item.dataset.category === category) && words.every((w) => item.dataset.search!.includes(w));
        item.hidden = !match;
        if (match) shown++;
      });
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.categoryFilter === category)));
      count.textContent = `${shown} dari ${items.length} project`;
      empty.hidden = shown > 0;

      const url = new URL(window.location.href);
      if (category) url.searchParams.set('kategori', category);
      else url.searchParams.delete('kategori');
      if (input.value.trim()) url.searchParams.set('q', input.value.trim());
      else url.searchParams.delete('q');
      // Pertahankan history.state milik ClientRouter
      history.replaceState(history.state, '', url);
    };

    root.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const button = target.closest<HTMLButtonElement>('[data-category-filter]');
      if (button) {
        category = button.dataset.categoryFilter!;
        apply();
      } else if (target.closest('[data-project-reset]')) {
        category = '';
        input.value = '';
        apply();
        input.focus();
      }
    });

    let debounce = 0;
    input.addEventListener('input', () => {
      window.clearTimeout(debounce);
      debounce = window.setTimeout(apply, 120);
    });

    apply();
    return () => window.clearTimeout(debounce);
  });
</script>
